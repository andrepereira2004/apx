#!/usr/bin/env python3
"""Environment-local appearance choices and a typed global icon-color preference."""
import hashlib
import json
import os
from pathlib import Path
import re
import signal
import subprocess
import sys
import tempfile

HOME = Path.home()
STATE = HOME / '.config/apx/appearance.json'
IMAGES = HOME / '.local/share/apx/appearance/wallpapers'
CLIENT = '/run/apx/host-services-client-v3.py'
DEFAULT_COLOR = '#d9dcea'
DEFAULT_STYLE = dict(color=DEFAULT_COLOR, icons=True, buttons=False, windows=False)


def color(value):
    if not isinstance(value, str) or not re.fullmatch(r'#[0-9a-fA-F]{6}', value):
        raise ValueError('Use uma cor no formato #RRGGBB.')
    return value.lower()


def validate_style(value):
    if not isinstance(value, dict) or set(value) != set(DEFAULT_STYLE) or any(type(value[k]) is not bool for k in ('icons', 'buttons', 'windows')):
        raise ValueError('Escolha os destinos da cor.')
    return {**value, 'color': color(value['color'])}


def local():
    try:
        data = json.loads(STATE.read_text())
        if not isinstance(data, dict): return {}
        result = {}
        if data.get('style') is not None: result['style'] = validate_style(data['style'])
        path = data.get('wallpaper')
        if isinstance(path, str) and Path(path).is_file() and Path(path).is_absolute(): result['wallpaper'] = path
        return result
    except (OSError, ValueError):
        return {}


def atomic(path, data):
    if path.is_symlink(): raise ValueError('Destino de preferências inválido.')
    if path.exists() and path.read_bytes() == data: return False
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    fd, temporary = tempfile.mkstemp(prefix='.appearance-', dir=path.parent)
    try:
        with os.fdopen(fd, 'wb') as stream:
            stream.write(data); stream.flush(); os.fsync(stream.fileno())
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary): os.unlink(temporary)
    return True


def save(values):
    atomic(STATE, (json.dumps(values, sort_keys=True) + '\n').encode())


def global_style(value=None):
    args = [CLIENT, 'appearance-load'] if value is None else [CLIENT, 'appearance-save', json.dumps(validate_style(value))]
    result = subprocess.run(args, capture_output=True, text=True, timeout=5)
    if result.returncode: raise RuntimeError('Não foi possível comunicar com a personalização global.')
    return validate_style(json.loads(result.stdout))


def mix(shade, accent, amount):
    first = [int(shade[i:i+2], 16) for i in (1, 3, 5)]
    second = [int(accent[i:i+2], 16) for i in (1, 3, 5)]
    return '#' + ''.join(f'{round(a*(1-amount)+b*amount):02x}' for a,b in zip(first, second))


def apply_theme(style):
    accent = style['color']; surface = mix('#0a1014', accent, .22)
    hover = mix('#0a1014', accent, .35)
    kitty = '# Generated by APX appearance; base terminal choices remain in kitty.conf.\n'
    if style['windows']: kitty += 'background ' + surface + '\n'
    changed = atomic(HOME / '.config/kitty/apx-appearance.conf', kitty.encode())
    if changed:
        for entry in Path('/proc').iterdir():
            if not entry.name.isdecimal(): continue
            try:
                if entry.stat().st_uid == os.getuid() and (entry / 'comm').read_text().strip() == 'kitty':
                    os.kill(int(entry.name), signal.SIGUSR1)
            except (OSError, ValueError): pass
    css_path = HOME / '.config/gtk-3.0/gtk.css'
    css = css_path.read_text() if css_path.exists() else ''
    marker = r'\n?/\* APX appearance override BEGIN \*/.*?/\* APX appearance override END \*/\n?'
    css = re.sub(marker, '', css, flags=re.S)
    window_surface = surface if style['windows'] else '#303445'
    extra = []
    rgb = ', '.join(str(int(window_surface[i:i+2],16)) for i in (1,3,5))
    extra += ['.thunar.background, .thunar infobar { background-color: rgba(' + rgb + ', 0.85); }',
                  '.thunar menu, .thunar popover { background-color: ' + window_surface + '; }']
    if style['buttons']:
        extra += ['.thunar button:hover, .thunar button:checked, .thunar .view:selected { background-color: ' + hover + '; }']
    if extra: css += '\n/* APX appearance override BEGIN */\n' + '\n'.join(extra) + '\n/* APX appearance override END */\n'
    atomic(css_path, css.encode())
    rofi = '/* Generated APX appearance overrides. */\n'
    rofi += 'launcherbox { background-color: ' + window_surface + 'd9; }\ninputbar { background-color: ' + window_surface + 'e6; }\n'
    if style['buttons']:
        rofi += 'element selected.normal, element selected.active { background-color: ' + hover + '; }\n'
    if style['icons']:
        rofi += 'element selected.normal, element selected.active, button selected.normal { text-color: ' + accent + '; border-color: ' + accent + '; }\n'
    atomic(HOME / '.config/rofi/apx-appearance.rasi', rofi.encode())
    # Only validated, local wallpaper references enter the lock configuration.
    chosen = local().get('wallpaper', str(HOME / '.config/apx/wallpapers/atlantic-coast.png'))
    if any(char in chosen for char in ('\n', '\r', '$', '#', '{', '}')): chosen = str(HOME / '.config/apx/wallpapers/atlantic-coast.png')
    lock = '# Generated Environment-local lock presentation; no authentication settings.\n'
    lock += '$apxLockAccent = rgba(' + (accent if style['icons'] else DEFAULT_COLOR).lstrip('#') + 'ff)\n'
    lock += 'background {\n    monitor =\n    path = ' + chosen + '\n    color = rgba(10, 16, 20, 1.0)\n    blur_passes = 3\n    blur_size = 7\n    brightness = 0.45\n}\n'
    atomic(HOME / '.config/hypr/apx-lock-appearance.conf', lock.encode())


def status():
    values = local(); cache = HOME / '.cache/apx/appearance-global.json'
    try:
        shared = global_style(); warning = ''
        atomic(cache, json.dumps(shared, sort_keys=True).encode())
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError):
        try: shared = validate_style(json.loads(cache.read_text()))
        except (OSError, ValueError): shared = dict(DEFAULT_STYLE)
        warning = 'Personalização global temporariamente indisponível.'
    effective = values.get('style', shared)
    apply_theme(effective)
    return dict(style=values.get('style'), global_style=shared, effective_style=effective,
                effective_icon_color=effective['color'] if effective['icons'] else DEFAULT_COLOR,
                surface=mix('#0a1014', effective['color'], .22),
                hover=mix('#0a1014', effective['color'], .35),
                active=mix('#0a1014', effective['color'], .45),
                border=mix('#0a1014', effective['color'], .55),
                wallpaper=Path(values['wallpaper']).as_uri() if values.get('wallpaper') else '', warning=warning)


def wallpaper(path):
    source = Path(path).expanduser().resolve(strict=True)
    if not source.is_file() or source.stat().st_size > 40 * 1024 * 1024:
        raise ValueError('Escolha uma imagem até 40 MB.')
    if source.suffix.lower() not in {'.png', '.jpg', '.jpeg', '.webp', '.bmp'}:
        raise ValueError('Escolha uma imagem PNG, JPEG, WebP ou BMP.')
    import gi
    gi.require_version('GdkPixbuf', '2.0')
    from gi.repository import GdkPixbuf
    info = GdkPixbuf.Pixbuf.get_file_info(str(source))
    if not info or not info[0] or min(info[1:]) <= 0 or max(info[1:]) > 16384:
        raise ValueError('Esta imagem não pode ser usada como wallpaper.')
    builtins = HOME / '.config/apx/wallpapers'
    if source.parent == builtins and source.name in {'atlantic-coast.png', 'alpine-lake.png', 'rainforest-stream.png'}:
        values = local(); values['wallpaper'] = str(source); save(values)
        return
    data = source.read_bytes()
    if len(data) > 40 * 1024 * 1024: raise ValueError('A imagem é demasiado grande.')
    target = IMAGES / (hashlib.sha256(data).hexdigest() + source.suffix.lower())
    atomic(target, data)
    values = local(); values['wallpaper'] = str(target); save(values)


def choose_wallpaper():
    import gi
    gi.require_version('Gtk', '3.0')
    from gi.repository import Gtk
    dialog = Gtk.FileChooserDialog(title='Wallpaper deste Environment', action=Gtk.FileChooserAction.OPEN)
    dialog.add_buttons('Cancelar', Gtk.ResponseType.CANCEL, 'Escolher imagem', Gtk.ResponseType.OK)
    pictures = HOME / 'Pictures'
    dialog.set_current_folder(str(pictures if pictures.is_dir() else HOME))
    image_filter = Gtk.FileFilter(); image_filter.set_name('Imagens (PNG, JPEG, WebP, BMP)')
    for mime in ('image/png', 'image/jpeg', 'image/webp', 'image/bmp'): image_filter.add_mime_type(mime)
    dialog.add_filter(image_filter)
    response = dialog.run(); selected = dialog.get_filename(); dialog.destroy()
    while Gtk.events_pending(): Gtk.main_iteration_do(False)
    if response == Gtk.ResponseType.OK and selected: wallpaper(selected)


def main(args):
    if args == ['get']: pass
    elif len(args) == 2 and args[0] == 'environment-style':
        values = local()
        if args[1] == 'inherit': values.pop('style', None)
        else: values['style'] = validate_style(json.loads(args[1]))
        save(values)
    elif len(args) == 2 and args[0] == 'global-style': global_style(json.loads(args[1]))
    elif len(args) == 2 and args[0] == 'wallpaper':
        if args[1] == 'default':
            values = local(); values.pop('wallpaper', None); save(values)
        else: wallpaper(args[1])
    elif args == ['choose-wallpaper']: choose_wallpaper()
    else: raise ValueError('Opção de personalização inválida.')
    print(json.dumps(status()))


if __name__ == '__main__':
    try: main(sys.argv[1:])
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        print(str(error), file=sys.stderr); sys.exit(1)
