#!/usr/bin/env python3
"""Opt-in native X11 buffers and matching font density for this Environment."""
import ctypes as C
import ctypes.util
import json
import os
from pathlib import Path
import subprocess


def apply():
    monitors=json.loads(subprocess.check_output(['hyprctl','-j','monitors'],text=True,timeout=3))
    monitor=next((m for m in monitors if m.get('focused')),monitors[0])
    scale=float(monitor['scale'])
    if not .75 <= scale <= 4: raise ValueError('Escala de ecrã inválida')
    x=C.CDLL(ctypes.util.find_library('X11'))
    x.XOpenDisplay.argtypes=[C.c_char_p];x.XOpenDisplay.restype=C.c_void_p
    display=x.XOpenDisplay(None)
    if not display: raise RuntimeError('Ecrã X11 indisponível')
    x.XResourceManagerString.argtypes=[C.c_void_p];x.XResourceManagerString.restype=C.c_char_p
    x.XDefaultRootWindow.argtypes=[C.c_void_p];x.XDefaultRootWindow.restype=C.c_ulong
    x.XInternAtom.argtypes=[C.c_void_p,C.c_char_p,C.c_int];x.XInternAtom.restype=C.c_ulong
    x.XChangeProperty.argtypes=[C.c_void_p,C.c_ulong,C.c_ulong,C.c_ulong,C.c_int,C.c_int,C.c_char_p,C.c_int]
    x.XCloseDisplay.argtypes=[C.c_void_p]
    try:
        old=x.XResourceManagerString(display) or b''
        lines=[line for line in old.splitlines() if not line.strip().startswith(b'Xft.dpi:')]
        data=b'\n'.join(lines+[('Xft.dpi: %.2f' % (96*scale)).encode()])+b'\n'
        x.XChangeProperty(display,x.XDefaultRootWindow(display),x.XInternAtom(display,b'RESOURCE_MANAGER',0),31,8,0,data,len(data))
    finally:x.XCloseDisplay(display)
    rule='hl.config({xwayland={force_zero_scaling=true}})\n'
    result=subprocess.run(['hyprctl','eval',rule],capture_output=True,text=True,timeout=3)
    if result.returncode or result.stdout.strip()!='ok':raise RuntimeError('Não foi possível aplicar a resolução X11')
    path=Path.home()/'.config/hypr/apx-x11-density.lua'
    content='-- APX opt-in: native X11 rendering with matching Xft density.\n'+rule
    if path.is_symlink():raise ValueError('Configuração X11 inválida')
    if not path.exists() or path.read_text()!=content:
        temporary=path.with_suffix('.lua.tmp');temporary.write_text(content);os.chmod(temporary,0o600);temporary.replace(path)
    print(json.dumps({'scale':scale,'dpi':96*scale,'native_buffers':True}))

if __name__=='__main__':
    apply()
