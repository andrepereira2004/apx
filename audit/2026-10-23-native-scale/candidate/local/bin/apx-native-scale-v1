#!/usr/bin/env python3
"""Prefer native Wayland for detected Electron apps; retain local app choices."""
import configparser
import io
import os
from pathlib import Path
import shlex
import shutil
import socket
import sys

MARKER = 'X-APX-Native-Scale'
HELPER = '/home/apx/.local/bin/apx-native-scale-v1'


def desktop(path):
    parser = configparser.ConfigParser(interpolation=None, strict=False)
    parser.optionxform = str
    parser.read(path)
    return parser


def electron_command(command):
    try:
        words = shlex.split(command)
    except ValueError:
        return False
    if not words or any(w.startswith('--ozone-platform') for w in words):
        return False  # An explicit vendor/backend choice takes precedence.
    executable = shutil.which(words[0])
    if not executable:
        return False
    binary = Path(executable).resolve()
    return (binary.name.startswith('electron') or
            (binary.parent / 'resources/app.asar').is_file() or
            (binary.parent / 'resources/default_app.asar').is_file())


def sync(sources=None, target=None):
    sources = sources or [Path('/usr/share/applications')]
    target = target or Path.home() / '.local/share/applications'
    target.mkdir(parents=True, exist_ok=True)
    wanted = set()
    for source in sources:
        for path in sorted(source.glob('*.desktop')):
            destination = target / path.name
            if destination.is_symlink():
                continue
            if destination.exists() and desktop(destination).get('Desktop Entry', MARKER, fallback='') != 'true':
                continue  # Never replace an owner's override.
            try:
                parser = desktop(path)
                entry = parser['Desktop Entry']
                if not electron_command(entry.get('Exec', '')):
                    continue
                wanted.add(path.name)
                entry[MARKER] = 'true'
                entry['DBusActivatable'] = 'false'
                for section in parser.sections():
                    command = parser[section].get('Exec', '')
                    if electron_command(command):
                        parser[section]['Exec'] = HELPER + ' run ' + command
                stream = io.StringIO()
                parser.write(stream, space_around_delimiters=False)
                content = stream.getvalue()
                if not destination.exists() or destination.read_text() != content:
                    temporary = destination.with_suffix('.desktop.tmp')
                    temporary.write_text(content)
                    temporary.replace(destination)
            except (OSError, configparser.Error, KeyError, ValueError) as error:
                print(f'Native scale: {path.name}: {error}', file=sys.stderr)
    for path in target.glob('*.desktop'):
        if not path.is_symlink() and path.name not in wanted:
            try:
                if desktop(path).get('Desktop Entry', MARKER, fallback='') == 'true':
                    path.unlink()
            except (OSError, configparser.Error):
                pass


def wayland_available(environment):
    name = environment.get('WAYLAND_DISPLAY', '')
    if not name:
        return False
    path = Path(name) if name.startswith('/') else Path(environment.get('XDG_RUNTIME_DIR', '/nonexistent')) / name
    client = socket.socket(socket.AF_UNIX)
    try:
        client.connect(str(path))
        return True
    except OSError:
        return False
    finally:
        client.close()


def main():
    if sys.argv[1:] == ['sync']:
        sync()
    elif len(sys.argv) > 2 and sys.argv[1] == 'run':
        command = sys.argv[2:]
        environment = dict(os.environ)
        if wayland_available(environment) and not any(w.startswith('--ozone-platform') for w in command):
            command.append('--ozone-platform=wayland')
        os.execvpe(command[0], command, environment)
    else:
        raise SystemExit('Uso: apx-native-scale-v1 sync | run aplicação [argumentos]')


if __name__ == '__main__':
    main()
