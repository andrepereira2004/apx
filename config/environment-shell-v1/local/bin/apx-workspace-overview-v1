#!/usr/bin/env python3
"""Search and switch numbered Hyprland workspaces with their app list."""
import json
import os
import shutil
import subprocess


def run_json(*args):
    result = subprocess.run(args, check=False, capture_output=True, text=True, timeout=3)
    if result.returncode != 0:
        return []
    try:
        return json.loads(result.stdout)
    except (TypeError, ValueError):
        return []


def main():
    rofi = shutil.which("rofi")
    hyprctl = shutil.which("hyprctl")
    if not rofi or not hyprctl:
        return 1
    clients = run_json(hyprctl, "-j", "clients")
    workspaces = run_json(hyprctl, "-j", "workspaces")
    rows = []
    targets = {}
    grouped = {}
    for client in clients:
        workspace = client.get("workspace", {})
        grouped.setdefault(int(workspace.get("id", 0)), []).append(client)
    ids = sorted({int(ws.get("id", 0)) for ws in workspaces} | set(grouped))
    for workspace_id in ids:
        if workspace_id <= 0:
            continue
        header = f"Workspace {workspace_id}"
        rows.append(header)
        targets[header] = ("workspace", workspace_id)
        for client in sorted(grouped.get(workspace_id, []), key=lambda item: (item.get("title") or "").lower()):
            title = (client.get("title") or client.get("class") or "Aplicação").strip()
            label = f"  └ {title}"
            rows.append(label)
            targets[label] = ("window", client.get("address", ""))
    if not rows:
        rows = ["Workspace 1"]
        targets[rows[0]] = ("workspace", 1)
    result = subprocess.run(
        [rofi, "-dmenu", "-no-custom", "-i", "-p", "Pesquisar workspaces"],
        input="\n".join(rows) + "\n", capture_output=True, text=True, check=False,
    )
    selected = result.stdout.strip()
    target = targets.get(selected)
    if not target:
        return 0
    if target[0] == "workspace":
        subprocess.run((hyprctl, "dispatch", "workspace", str(target[1])), check=False, timeout=3)
    elif target[1]:
        subprocess.run((hyprctl, "dispatch", "focuswindow", f"address:{target[1]}"), check=False, timeout=3)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
