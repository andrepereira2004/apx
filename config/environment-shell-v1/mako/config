# Common notification cards for every app, including Thunderbird.
# Keep these defaults above all criteria so they are not browser-only.
font=Selawik 11
background-color=#0a1014ee
text-color=#c6cdd3
border-color=#26343a
border-size=1
border-radius=10
width=380
height=180
padding=16
outer-margin=8,20,12
margin=0,0,8
icons=1
max-icon-size=36
icon-path=/usr/share/icons/Papirus:/usr/share/icons/hicolor
icon-location=left
markup=1
format=<span foreground="#9ba3ac" size="small">%a</span>\n<span foreground="#eceef0" weight="bold">%s</span>\n%b
text-alignment=left
anchor=top-right
max-visible=3

# Terminal notifications must remain useful without becoming permanent UI.
# A separate focus watcher dismisses them as soon as their terminal is visited;
# this timeout also handles notifications emitted while it is already focused.
[app-name=kitty]
default-timeout=8000
ignore-timeout=1

[app-name=Alacritty]
default-timeout=8000
ignore-timeout=1

[app-name=alacritty]
default-timeout=8000
ignore-timeout=1

# Browser handoff: click its default action and expire without history.
[app-name="APX Browser"]
default-timeout=5000
ignore-timeout=1
history=0
on-button-left=invoke-default-action
on-touch=invoke-default-action

# An early click explicitly requests waiting until the browser is ready.
[app-name="APX Browser" category=apx-redirect-wait]
default-timeout=120000
ignore-timeout=1
