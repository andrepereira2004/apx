#!/usr/bin/env bash
set -euo pipefail

"${HOME}/.local/bin/apx-native-scale-v1" sync

catalog="${HOME}/Applications"
mkdir -p "${catalog}"
find "${catalog}" -maxdepth 1 -type l -delete
find "${catalog}" -maxdepth 1 -type f -name '*.desktop' -delete

sources=(
  "${HOME}/.local/share/applications"
  /usr/share/applications
  /var/lib/flatpak/exports/share/applications
  "${HOME}/.local/share/flatpak/exports/share/applications"
)
for directory in "${sources[@]}"; do
  [[ -d "${directory}" ]] || continue
  while IFS= read -r -d '' entry; do
    [[ -f "${entry}" ]] || continue
    name="${entry##*/}"
    [[ "${name}" == *.desktop ]] || continue
    [[ -e "${catalog}/${name}" ]] && continue
    ln -s -- "${entry}" "${catalog}/${name}"
  done < <(find "${directory}" -maxdepth 1 \( -type f -o -type l \) -name '*.desktop' -print0 2>/dev/null)
done
