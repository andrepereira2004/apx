QWidget { background-color: #101117; color: #d9dcea; font-family: Inter; font-size: 12pt; }
QTabWidget::pane { border: 1px solid #414654; border-radius: 10px; top: -1px; }
QTabBar::tab { background: #1b1d26; border: 1px solid #414654; padding: 9px 18px; min-width: 80px; }
QTabBar::tab:selected { background: #353a4a; color: #ffffff; border-bottom: 2px solid #8ab4ff; }
QTabBar::tab:hover { background: #292d3a; }
QScrollArea { border: 0; background: #101117; }
QScrollArea QWidget { background: #101117; }
QPushButton { background: #1b1d26; color: #d9dcea; border: 1px solid #414654; border-radius: 10px; padding: 8px 12px; text-align: left; }
QPushButton:hover { background: #353a4a; color: #ffffff; border-color: #8ab4ff; }
QPushButton:focus { border-color: #8ab4ff; }
QCheckBox { spacing: 8px; padding: 8px 0; }
QCheckBox::indicator { width: 16px; height: 16px; border: 1px solid #8a92a5; border-radius: 4px; background: #1b1d26; }
QCheckBox::indicator:checked { background: #8ab4ff; border-color: #8ab4ff; }
QScrollBar:vertical { background: #101117; width: 9px; }
QScrollBar::handle:vertical { background: #414654; border-radius: 4px; min-height: 30px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
