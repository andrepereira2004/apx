+//! Parent native Open dialogs to the window and wait away from the event loop.
+use std::sync::mpsc::{Receiver, Sender, channel};
+
+type Answer = Result<Option<String>, String>;
+type Request = Sender<Answer>;
+pub type Hook = Box<dyn Fn() -> Receiver<Answer>>;
+
+pub struct Launcher {
+    queue: Receiver<Request>,
+    ctx: egui::Context,
+}
+
+pub fn hook(ctx: &egui::Context) -> (Hook, Launcher) {
+    let (tx, queue) = channel();
+    let hook: Hook = Box::new(move || {
+        let (answer, rx) = channel();
+        let _ = tx.send(answer);
+        rx
+    });
+    (hook, Launcher { queue, ctx: ctx.clone() })
+}
+
+impl Launcher {
+    pub fn show(&self, parent: &eframe::Frame) {
+        while let Ok(answer) = self.queue.try_recv() {
+            // Construct on the window thread; poll the portal future on a worker.
+            let picking = rfd::AsyncFileDialog::new()
+                .set_parent(parent)
+                .add_filter("Spreadsheets", &["xlsx", "xlsm", "xls", "xlsb", "ods", "csv", "tsv", "txt", "json"])
+                .add_filter("Excel Workbook", &["xlsx", "xlsm"])
+                .add_filter("Excel 97-2003 Workbook (import)", &["xls"])
+                .add_filter("Excel Binary Workbook (data import)", &["xlsb"])
+                .add_filter("OpenDocument Spreadsheet (data import)", &["ods"])
+                .add_filter("CSV", &["csv"])
+                .pick_file();
+            let failed = answer.clone();
+            let ctx = self.ctx.clone();
+            if let Err(error) = std::thread::Builder::new().name("Open file selector".into()).spawn(move || {
+                let path = pollster::block_on(picking).map(|file| file.path().to_string_lossy().into_owned());
+                let _ = answer.send(Ok(path));
+                ctx.request_repaint();
+            }) {
+                let _ = failed.send(Err(format!("Could not start the file selector: {error}")));
+                self.ctx.request_repaint();
+            }
+        }
+    }
+}
