#!/usr/bin/env python3
"""Send read-only source files as new copies to the shared folder."""

import json
import os
from pathlib import Path
import socket
import stat
import struct
import sys

SOCKET = '/home/apx/Partilha/.apx-transfer.sock'
SHARED = Path('/home/apx/Partilha')


def request(header, source=None):
    data = json.dumps(header).encode()
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as conn:
        conn.connect(SOCKET)
        conn.sendall(struct.pack('!I', len(data)) + data)
        if source is not None:
            descriptor = os.open(source, os.O_RDONLY | os.O_NOFOLLOW)
            with os.fdopen(descriptor, 'rb', buffering=0) as stream:
                info = os.fstat(stream.fileno())
                if not stat.S_ISREG(info.st_mode) or info.st_size != header['size']:
                    raise RuntimeError('source changed during copying')
                remaining = header['size']
                while remaining:
                    chunk = stream.read(min(65536, remaining))
                    if not chunk:
                        raise RuntimeError('source changed during copying')
                    conn.sendall(chunk)
                    remaining -= len(chunk)
        length = struct.unpack('!I', read_exact(conn, 4))[0]
        result = json.loads(read_exact(conn, length))
        if not result.get('ok'):
            raise RuntimeError(result.get('error', 'copy rejected'))


def read_exact(conn, count):
    data = bytearray()
    while len(data) < count:
        chunk = conn.recv(count - len(data))
        if not chunk:
            raise RuntimeError('copy service disconnected')
        data.extend(chunk)
    return bytes(data)


def copy(path, prefix):
    info = path.lstat()
    target = f'{prefix}/{path.name}' if prefix else path.name
    if stat.S_ISDIR(info.st_mode):
        request({'type': 'dir', 'path': target})
        for child in path.iterdir():
            copy(child, target)
    elif stat.S_ISREG(info.st_mode) and info.st_nlink == 1:
        request({'type': 'file', 'path': target, 'size': info.st_size,
                 'executable': bool(info.st_mode & 0o111)}, path)
    else:
        raise RuntimeError(f'not a regular independent file: {path}')


def dialog(message, error=False):
    try:
        import gi
        gi.require_version('Gtk', '3.0')
        from gi.repository import Gtk
        popup = Gtk.MessageDialog(message_type=Gtk.MessageType.ERROR if error else Gtk.MessageType.INFO,
                                  buttons=Gtk.ButtonsType.OK, text=message)
        popup.run()
        popup.destroy()
    except ImportError:
        print(message, file=sys.stderr if error else sys.stdout)


def mkdir_dialog(parent):
    import gi
    gi.require_version('Gtk', '3.0')
    from gi.repository import Gtk
    popup = Gtk.Dialog(title='Nova subpasta na Partilha')
    popup.add_button('Cancelar', Gtk.ResponseType.CANCEL)
    popup.add_button('Criar', Gtk.ResponseType.OK)
    entry = Gtk.Entry()
    entry.set_activates_default(True)
    entry.set_placeholder_text('Nome da subpasta')
    popup.get_content_area().add(entry)
    popup.set_default_response(Gtk.ResponseType.OK)
    popup.show_all()
    try:
        if popup.run() == Gtk.ResponseType.OK:
            name = entry.get_text().strip()
            if not name or '/' in name or name in ('.', '..'):
                raise RuntimeError('Nome de pasta inválido')
            request({'type': 'dir', 'path': f'{parent}/{name}' if parent else name})
    finally:
        popup.destroy()


def rename_dialog(path):
    import gi
    gi.require_version('Gtk', '3.0')
    from gi.repository import Gtk
    if path.is_symlink() or path == SHARED or SHARED not in path.resolve(strict=True).parents:
        raise RuntimeError('Seleciona um ficheiro ou pasta dentro da Partilha')
    popup = Gtk.Dialog(title='Mudar nome na Partilha')
    popup.add_button('Cancelar', Gtk.ResponseType.CANCEL)
    popup.add_button('Mudar nome', Gtk.ResponseType.OK)
    entry = Gtk.Entry(text=path.name); entry.set_activates_default(True)
    popup.get_content_area().add(entry); popup.set_default_response(Gtk.ResponseType.OK)
    popup.show_all(); entry.grab_focus(); entry.select_region(0, -1)
    try:
        if popup.run() == Gtk.ResponseType.OK:
            request({'type': 'rename', 'path': str(path.relative_to(SHARED)), 'name': entry.get_text()})
    finally: popup.destroy()


def main():
    try:
        if len(sys.argv) == 3 and sys.argv[1] == 'rename':
            rename_dialog(Path(sys.argv[2]))
        elif len(sys.argv) >= 3 and sys.argv[1] == 'mkdir':
            parent = Path(sys.argv[2]).resolve(strict=True)
            if parent != SHARED and SHARED not in parent.parents:
                raise RuntimeError('Seleciona uma pasta dentro da Partilha')
            mkdir_dialog('' if parent == SHARED else str(parent.relative_to(SHARED)))
        elif len(sys.argv) >= 3 and sys.argv[1] == 'copy':
            for name in sys.argv[2:]:
                path = Path(name)
                if path == SHARED or SHARED in path.resolve().parents:
                    raise RuntimeError('A origem já está na Partilha')
                copy(path, '')
            dialog('Cópia enviada para Partilha Environments')
        else:
            raise RuntimeError('Uso: apx-share-copy-v1 copy FICHEIRO... | mkdir PASTA')
    except (OSError, RuntimeError, ValueError) as exc:
        dialog(str(exc), error=True)
        return 1
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
