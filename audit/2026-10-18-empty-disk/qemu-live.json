[
  "/usr/bin/qemu-system-x86_64",
  "-name",
  "APX Empty Disk Rehearsal",
  "-machine",
  "q35,accel=kvm",
  "-cpu",
  "host",
  "-m",
  "6144",
  "-smp",
  "4",
  "-nodefaults",
  "-display",
  "none",
  "-drive",
  "if=pflash,format=raw,readonly=on,file=/usr/share/edk2/x64/OVMF_CODE.4m.fd",
  "-drive",
  "if=pflash,format=raw,file=/lab/vars.fd",
  "-drive",
  "if=none,id=disk,format=raw,discard=unmap,detect-zeroes=unmap,file=/lab/disk.raw",
  "-device",
  "virtio-blk-pci,drive=disk",
  "-device",
  "virtio-vga",
  "-device",
  "qemu-xhci",
  "-device",
  "usb-kbd",
  "-device",
  "usb-tablet",
  "-netdev",
  "user,id=n0",
  "-device",
  "virtio-net-pci,netdev=n0",
  "-device",
  "virtio-serial-pci",
  "-chardev",
  "socket,id=lab,path=/lab/agent.sock,server=on,wait=off",
  "-device",
  "virtserialport,chardev=lab,name=apx.lab",
  "-qmp",
  "unix:/lab/qmp.sock,server=on,wait=off",
  "-serial",
  "file:/lab/serial-live.log",
  "-drive",
  "if=none,id=cd,media=cdrom,readonly=on,file=/lab/arch.iso",
  "-device",
  "ide-cd,drive=cd",
  "-boot",
  "order=d"
]
