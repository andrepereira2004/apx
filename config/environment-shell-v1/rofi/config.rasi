configuration {
    modi: "apps,files:/home/apx/.local/bin/apx-rofi-files-v1";
    kb-mode-next: "Tab,Control+Tab";
    kb-mode-previous: "ISO_Left_Tab,Control+ISO_Left_Tab";
    kb-row-tab: "";
    kb-element-next: "";
    kb-element-prev: "";
    display-filebrowser: "Ficheiros";
    display-files: "Ficheiros";
    filebrowser {
        directory: "/home/apx";
        directories-first: true;
        sorting-method: "name";
        show-hidden: false;
        command: "xdg-open";
    }
    show-icons: true;
    icon-theme: "APX-Graphite";
    font: "JetBrains Mono 11";
    display-drun: "Apps";
    display-apps: "Apps";
    sidebar-mode: true;
    display-run: "Executar";
    display-window: "Pesquisar workspaces";
    drun-display-format: "{name}";
    drun-use-desktop-cache: false;
    click-to-exit: true;
    window-format: "Workspace {w}  •  {c}  —  {t}";
}
* {
    background-color: transparent;
    text-color: #d9dcea;
    border-color: #414654;
}
window { fullscreen: false; location: south; anchor: south; width: 100%; height: 100%; background-color: transparent; border: 0px; padding: 0px; }
mainbox { children: [button-dismiss-top, centerbox, button-dismiss-bottom]; spacing: 0px; }
centerbox { orientation: horizontal; children: [button-dismiss-left, launcherbox, button-dismiss-right]; expand: false; spacing: 0px; }
launcherbox {
    children: [headerbox, apx-separator, inputbar, listview];
    width: 580px; expand: false;
    background-color: #101117d9;
    border: 1px; border-color: #343947; border-radius: 10px;
    padding: 18px; spacing: 12px;
}
headerbox {
    orientation: horizontal;
    children: [header-spacer, mode-switcher];
    height: 36px;
    expand: false;
}
header-spacer { expand: true; }
mode-switcher {
    width: 248px;
    height: 36px;
    orientation: horizontal;
    spacing: 8px;
    expand: false;
}
button {
    width: 120px;
    height: 36px;
    expand: false;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    font: "JetBrains Mono 10";
    padding: 5px 8px;
    border: 1px;
    border-color: #414654;
    border-radius: 14px;
    background-color: #1b1d26;
    text-color: #a4abc0;
}
button selected.normal {
    background-color: #353a4a;
    border-color: #69728a;
    text-color: #ffffff;
}
apx-separator { width: 542px; height: 1px; expand: false; background-color: #414654; }
button-dismiss-top, button-dismiss-bottom, button-dismiss-left, button-dismiss-right {
    content: " ";
    width: 100%;
    action: "kb-cancel";
    expand: true;
    background-color: transparent; border: 0px; padding: 0px;
}
inputbar {
    children: [entry];
    spacing: 12px;
    padding: 14px;
    background-color: #1b1d26;
    border: 1px;
    border-color: #414654;
    border-radius: 14px;
}
prompt { text-color: #d9dcea; vertical-align: 0.5; }
entry { text-color: #ffffff; placeholder: "Pesquisar…"; placeholder-color: #a4abc0; }
listview { border: 0px; lines: 7; fixed-height: true; spacing: 6px; scrollbar: false; }
element { height: 50px; padding: 12px 14px; spacing: 12px; border: 1px; border-color: transparent; border-radius: 14px; }
element normal.normal { background-color: #1b1d26; text-color: #d9dcea; }
element alternate.normal { background-color: #1b1d26; text-color: #d9dcea; }
element normal.urgent, element alternate.urgent, element selected.urgent,
element normal.active, element alternate.active, element selected.active {
    background-color: transparent;
    text-color: #d9dcea;
}
element selected.normal, element normal.active, element alternate.active, element selected.active { background-color: #353a4a; border-color: #69728a; text-color: #ffffff; }
element-icon { size: 22px; }
element-text { vertical-align: 0.5; text-color: inherit; }

button-dismiss-left, button-dismiss-right { width: calc((100% - 580px) / 2); }


@import "apx-appearance.rasi"
