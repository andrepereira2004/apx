#!/usr/bin/env python3
"""Full-resolution capture, expiring preview, and fitted image actions."""
import datetime
import fcntl
import os
from pathlib import Path
import shutil
import subprocess
import tempfile
import logging
import time


def notify(message):
    subprocess.run(["notify-send", "-a", "APX", "Captura de ecrã", message], check=False)


def save_as(source):
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk
    dialog = Gtk.FileChooserDialog(title="Guardar captura de ecrã", action=Gtk.FileChooserAction.SAVE)
    dialog.add_buttons("Cancelar", Gtk.ResponseType.CANCEL, "Guardar", Gtk.ResponseType.ACCEPT)
    dialog.set_do_overwrite_confirmation(True)
    dialog.set_current_name("Captura_" + datetime.datetime.now().strftime("%Y-%m-%d_%H-%M-%S") + ".png")
    dialog.set_current_folder(str(Path.home() / "Pictures"))
    result = False
    if dialog.run() == Gtk.ResponseType.ACCEPT:
        destination = Path(dialog.get_filename())
        if destination.suffix.lower() != ".png":
            destination = Path(str(destination) + ".png")
            if destination.exists():
                dialog.destroy()
                notify("Esse ficheiro já existe. Escolhe outro nome.")
                return False
        shutil.copyfile(source, destination)
        result = True
    dialog.destroy()
    while Gtk.events_pending():
        Gtk.main_iteration()
    return result


def expand(source):
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk, GdkPixbuf, Gdk, GLib
    import cairo
    window = Gtk.Dialog(title="Captura de ecrã")
    display = Gdk.Display.get_default()
    monitor = display.get_primary_monitor() or display.get_monitor(0)
    geometry = monitor.get_workarea()
    window.set_default_size(min(1120, int(geometry.width * .85)),
                            min(780, int(geometry.height * .85)))
    window.set_size_request(320, 240)
    window.set_resizable(True)
    window.set_keep_above(True)
    pixbuf = GdkPixbuf.Pixbuf.new_from_file(str(source))
    original_width, original_height = pixbuf.get_width(), pixbuf.get_height()
    current = [pixbuf]
    history = [(0,0,original_width,original_height)]
    history_index = [0]
    selection = [0, 0, original_width, original_height]
    drag = {}
    def full_rect():
        return [0, 0, current[0].get_width(), current[0].get_height()]
    def pending():
        return selection != full_rect()

    provider = Gtk.CssProvider()
    provider.load_from_data(b"""
        dialog.capture { background: #101117; color: #d9dcea; font-family: 'JetBrains Mono'; font-size: 12px; }
        .capture button.action, .capture button.control { background-image: none;
            background-color: #1b1d26; color: #d9dcea; border: 1px solid #343947;
            border-radius: 9px; padding: 6px 9px; box-shadow: none; text-shadow: none;
            transition: background-color 140ms ease, border-color 140ms ease; }
        .capture button.action:hover, .capture button.control:hover { background-color: #292d3a; border-color: #9da8c2; }
        .capture button.action:active, .capture button.control:active, .capture button.control:checked { background-color: #353a4a; }
        .capture button:focus { border-color: #55e6ff; }
        .capture button:disabled { opacity: .35; }
        .capture button.save { border-color: #667184; }
        .capture .muted { color: #a4abc0; font-size: 11px; }
        .capture spinbutton { background: #1b1d26; color: #d9dcea; border: 1px solid #343947; border-radius: 8px; }
        .capture spinbutton entry { background: transparent; color: #d9dcea; padding: 8px; min-width: 58px; }
        .capture spinbutton button { background-image: none; background: transparent; color: #a4abc0; border: none; box-shadow: none; }
        .capture separator { background: #343947; min-height: 1px; }
    """)
    window.get_style_context().add_class("capture")
    Gtk.StyleContext.add_provider_for_screen(window.get_screen(), provider,
                                             Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def icon_image(name):
        gi.require_version("Rsvg", "2.0")
        from gi.repository import Rsvg
        svg = (Path.home() / ".config/quickshell/apx/icons/lucide" / (name + ".svg")).read_bytes()
        handle = Rsvg.Handle.new_from_data(svg.replace(b"currentColor", b"#d9dcea"))
        icon = Gtk.DrawingArea()
        icon.set_size_request(18, 18)
        icon.set_halign(Gtk.Align.CENTER)
        icon.set_valign(Gtk.Align.CENTER)
        def draw_icon(widget, context):
            scale = max(1, widget.get_scale_factor())
            viewport = Rsvg.Rectangle()
            viewport.x = round((widget.get_allocated_width()-16)*scale/2)/scale
            viewport.y = round((widget.get_allocated_height()-16)*scale/2)/scale
            viewport.width = 16
            viewport.height = 16
            # Render the original vector in the actual widget context. Focus
            # changes cannot resample or stretch an intermediate icon bitmap.
            handle.render_document(context, viewport)
            return False
        icon.connect("draw", draw_icon)
        return icon

    def button_content(button, icon, label, style="action"):
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=9)
        row.set_halign(Gtk.Align.CENTER)
        row.pack_start(icon_image(icon), False, False, 0)
        if label:
            text = Gtk.Label(label=label)
            text.set_valign(Gtk.Align.CENTER)
            row.pack_start(text, False, False, 0)
        button.add(row)
        button.get_style_context().add_class(style)
        return button

    content = window.get_content_area()
    content.set_spacing(0)
    preview = Gtk.DrawingArea()
    preview.set_hexpand(True)
    preview.set_vexpand(True)
    def geometry():
        image = current[0]
        width, height = preview.get_allocated_width(), preview.get_allocated_height()
        # Reserve space inside the drawing area so handles at the image
        # corners stay visible and their drag targets do not hit the clip edge.
        inset = 12
        fit = max(.0001, min(max(1,width-2*inset) / image.get_width(),
                             max(1,height-2*inset) / image.get_height(), 1.0))
        scale=max(1,preview.get_scale_factor())
        # Place the preview on physical pixel boundaries; fractional origins
        # otherwise introduce another interpolation pass and soften text.
        return (round((width-image.get_width()*fit)*scale/2)/scale,
                round((height-image.get_height()*fit)*scale/2)/scale,fit)

    render_cache = {}
    cursors = {}
    last_cursor = [None]
    last_selection = [None]
    resize_idle = [0]

    def cache_key():
        image=current[0]
        fit=geometry()[2]
        scale=max(1,preview.get_scale_factor())
        return (id(image),max(1,round(image.get_width()*fit*scale)),
                max(1,round(image.get_height()*fit*scale)),scale)

    def prepare_cache():
        key=cache_key()
        if render_cache.get("key") != key:
            image=current[0]
            scaled=image.scale_simple(key[1],key[2],GdkPixbuf.InterpType.HYPER)
            # Keep a Cairo surface, avoiding pixbuf-to-Cairo conversion on
            # every drag frame. Store physical pixels, with the correct scale.
            surface=Gdk.cairo_surface_create_from_pixbuf(scaled,key[3],None)
            render_cache.update(key=key,surface=surface,
                                width=key[1]/key[3],height=key[2]/key[3])
        return False

    def settle_resize():
        resize_idle[0]=0
        prepare_cache()
        preview.queue_draw()
        return False

    def draw(widget, context):
        image = current[0]
        ox, oy, fit = geometry()
        key=cache_key()
        if not render_cache or render_cache.get("key",())[0] != id(image):
            prepare_cache()
        elif render_cache.get("key") != key:
            # During window resizing reuse the surface; build the sharp final
            # image once the allocation settles, not on each resize event.
            if resize_idle[0]: GLib.source_remove(resize_idle[0])
            resize_idle[0]=GLib.timeout_add(100,settle_resize)
        context.save()
        context.translate(ox,oy)
        context.save()
        settled=render_cache.get("key")==key
        if not settled:
            context.scale(image.get_width()*fit/render_cache["width"],
                          image.get_height()*fit/render_cache["height"])
        context.set_source_surface(render_cache["surface"],0,0)
        # The settled surface is already sampled to the framebuffer pixels.
        # Do not scale/filter it a second time, even by a fractional pixel.
        context.get_source().set_filter(cairo.FILTER_NEAREST if settled else cairo.FILTER_GOOD)
        context.paint()
        context.restore()
        context.scale(fit, fit)
        x, y, width, height = selection
        context.set_source_rgba(0.02, .03, .05, .58)
        context.rectangle(0, 0, image.get_width(), image.get_height())
        context.rectangle(x, y, width, height)
        context.set_fill_rule(cairo.FILL_RULE_EVEN_ODD)
        context.fill()
        context.set_source_rgb(.65, .82, .89)
        context.set_line_width(1.4 / fit)
        context.rectangle(x, y, width, height)
        context.stroke()
        # Handles stay the same screen size as the window is resized.
        for hx, hy in ((x,y),(x+width/2,y),(x+width,y),(x,y+height/2),
                       (x+width,y+height/2),(x,y+height),(x+width/2,y+height),(x+width,y+height)):
            context.rectangle(hx-3/fit, hy-3/fit, 6/fit, 6/fit)
            context.fill()
        context.restore()
        return False

    def update():
        apply_button.set_sensitive(pending())
        undo_button.set_sensitive(history_index[0]>0)
        redo_button.set_sensitive(history_index[0]+1<len(history))
        previous=last_selection[0]
        last_selection[0]=selection[:]
        if previous is None or not render_cache or previous==selection:
            preview.queue_draw()
            return
        ox,oy,fit=geometry()
        def screen_rect(rect):
            x,y,w,h=rect
            return [ox+x*fit,oy+y*fit,ox+(x+w)*fit,oy+(y+h)*fit]
        old,new=screen_rect(previous),screen_rect(selection)
        regions=[]
        # Only shade/unshade the symmetric difference between the rectangles.
        def subtract(a,b):
            l,t,r,bottom=a
            il,it,ir,ib=max(l,b[0]),max(t,b[1]),min(r,b[2]),min(bottom,b[3])
            if ir<=il or ib<=it:
                regions.append(a);return
            regions.extend(([l,t,r,it],[l,ib,r,bottom],[l,it,il,ib],[ir,it,r,ib]))
        subtract(old,new);subtract(new,old)
        # Repaint the outline and eight small handles, including old positions.
        for l,t,r,bottom in (old,new):
            regions.extend(([l-5,t-5,r+5,t+5],[l-5,bottom-5,r+5,bottom+5],
                            [l-5,t-5,l+5,bottom+5],[r-5,t-5,r+5,bottom+5]))
        import math
        for l,t,r,bottom in regions:
            left,top=max(0,math.floor(l)-1),max(0,math.floor(t)-1)
            right=min(preview.get_allocated_width(),math.ceil(r)+1)
            lower=min(preview.get_allocated_height(),math.ceil(bottom)+1)
            if right>left and lower>top:
                preview.queue_draw_area(left,top,right-left,lower-top)

    def point(event):
        ox, oy, fit = geometry()
        return ((event.x-ox)/fit, (event.y-oy)/fit)

    def hit(x, y):
        left, top, width, height = selection
        right, bottom = left+width, top+height
        tolerance = 10 / geometry()[2]
        near_x = left-tolerance <= x <= right+tolerance
        near_y = top-tolerance <= y <= bottom+tolerance
        edges = ""
        if near_y:
            if abs(x-left) <= tolerance: edges += "w"
            elif abs(x-right) <= tolerance: edges += "e"
        if near_x:
            if abs(y-top) <= tolerance: edges += "n"
            elif abs(y-bottom) <= tolerance: edges += "s"
        return edges

    def press(widget, event):
        if event.button != 1: return False
        x,y=point(event)
        image=current[0]
        x=max(0,min(image.get_width(),x)); y=max(0,min(image.get_height(),y))
        mode=hit(x,y)
        if not mode:
            left,top,width,height=selection
            mode="move" if pending() and left<=x<=left+width and top<=y<=top+height else "new"
        drag.update(mode=mode, x=x, y=y, rect=selection[:])
        if mode=="new": selection[:]=[round(x),round(y),1,1];update()
        return True

    def motion(widget, event):
        x,y=point(event)
        if not drag:
            mode=hit(x,y)
            names={"n":"n-resize","s":"s-resize","e":"e-resize","w":"w-resize",
                   "wn":"nw-resize","en":"ne-resize","ws":"sw-resize","es":"se-resize"}
            name=names.get(mode,"crosshair")
            if name != last_cursor[0] and widget.get_window():
                if name not in cursors: cursors[name]=Gdk.Cursor.new_from_name(display,name)
                widget.get_window().set_cursor(cursors[name]);last_cursor[0]=name
            return False
        image=current[0]; iw,ih=image.get_width(),image.get_height()
        x=max(0,min(iw,x)); y=max(0,min(ih,y))
        mode=drag["mode"];left,top,width,height=drag["rect"]
        if mode=="new":
            x1,x2=sorted((round(drag["x"]),round(x))); y1,y2=sorted((round(drag["y"]),round(y)))
            selection[:]=[min(iw-1,x1),min(ih-1,y1),max(1,x2-x1),max(1,y2-y1)]
        elif mode=="move":
            selection[:]=[max(0,min(iw-width,round(left+x-drag["x"]))),
                          max(0,min(ih-height,round(top+y-drag["y"]))),width,height]
        else:
            right,bottom=left+width,top+height
            if "w" in mode:left=max(0,min(right-1,round(x)))
            if "e" in mode:right=min(iw,max(left+1,round(x)))
            if "n" in mode:top=max(0,min(bottom-1,round(y)))
            if "s" in mode:bottom=min(ih,max(top+1,round(y)))
            selection[:]=[left,top,right-left,bottom-top]
        update(); return True

    def release(widget,event):
        if event.button==1:
            drag.clear()
            window.set_title(f"Captura de ecrã · {selection[2]} × {selection[3]} px")
            return True
        return False

    preview.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK | Gdk.EventMask.POINTER_MOTION_MASK)
    preview.connect("draw",draw)
    preview.connect("button-press-event",press)
    preview.connect("motion-notify-event",motion)
    preview.connect("button-release-event",release)
    for edge in ("start", "end", "top", "bottom"):
        getattr(preview, "set_margin_" + edge)(8)
    content.pack_start(preview, True, True, 0)
    content.pack_start(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL), False, False, 0)
    footer=Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL,spacing=6)
    footer.set_halign(Gtk.Align.CENTER)
    footer.set_margin_top(7)
    footer.set_margin_bottom(7)
    footer.set_margin_start(8)
    footer.set_margin_end(8)
    undo_button=button_content(Gtk.Button(),"undo-2","")
    redo_button=button_content(Gtk.Button(),"redo-2","")
    reset=button_content(Gtk.Button(),"rotate-cw","Original")
    apply_button=button_content(Gtk.Button(),"check","Aplicar")
    delete=button_content(Gtk.Button(),"trash-2","Apagar")
    copy=button_content(Gtk.Button(),"copy","Copiar")
    save=button_content(Gtk.Button(),"save","Guardar")
    save.get_style_context().add_class("save")
    buttons=(undo_button,redo_button,reset,apply_button,delete,copy,save)
    labels=("Desfazer (Ctrl+Z)","Refazer (Ctrl+Y)","Repor original","Aplicar recorte (Enter)","Apagar","Copiar","Guardar")
    for button,label in zip(buttons,labels):
        button.set_size_request(34,32)
        button.set_tooltip_text(label)
        button.get_accessible().set_name(label)
        footer.pack_start(button,False,False,0)
    def compact(widget,allocation):
        narrow=allocation.width<660
        for button in buttons:
            for child in button.get_child().get_children():
                if isinstance(child,Gtk.Label):child.set_visible(not narrow)
    preview.connect("size-allocate",compact)
    def load_history():
        rect=history[history_index[0]]
        current[0]=pixbuf if rect==history[0] else pixbuf.new_subpixbuf(*rect)
        selection[:]=full_rect()
        render_cache.clear();drag.clear();last_selection[0]=None
        window.set_title(f"Captura de ecrã · {rect[2]} × {rect[3]} px")
        update()

    def commit(rect):
        rect=tuple(rect)
        if rect!=history[history_index[0]]:
            del history[history_index[0]+1:]
            history.append(rect)
            history_index[0]+=1
        load_history()

    def apply_crop(_=None):
        if pending():
            x,y,_,_=history[history_index[0]]
            sx,sy,width,height=selection
            commit((x+sx,y+sy,width,height))

    def restore(_):
        commit(history[0])

    def undo(_=None):
        if history_index[0]>0:
            history_index[0]-=1
            load_history()

    def redo(_=None):
        if history_index[0]+1<len(history):
            history_index[0]+=1
            load_history()

    reset.connect("clicked",restore)
    apply_button.connect("clicked",apply_crop)
    undo_button.connect("clicked",undo)
    redo_button.connect("clicked",redo)
    def key_press(widget,event):
        if event.state & Gdk.ModifierType.CONTROL_MASK:
            key=Gdk.keyval_to_lower(event.keyval)
            if key==Gdk.KEY_z:
                if event.state & Gdk.ModifierType.SHIFT_MASK: redo()
                else: undo()
                return True
            if key==Gdk.KEY_y:
                redo();return True
        if event.keyval in (Gdk.KEY_Return,Gdk.KEY_KP_Enter):
            apply_crop(); return True
        return False
    window.connect("key-press-event",key_press)
    for button,response in ((save,1),(delete,2),(copy,3)):
        button.connect("clicked",lambda _,value=response:window.response(value))
    content.pack_start(footer,False,False,0)
    update()
    window.show_all()
    window.get_action_area().hide()
    window.present()
    try:
        while True:
            action = window.run()
            if action not in (1, 3):
                break  # Delete, Escape and title-bar close all discard.
            apply_crop()
            rendered = source
            temporary = None
            try:
                if current[0] is not pixbuf:
                    fd, filename = tempfile.mkstemp(prefix="crop-", suffix=".png", dir=source.parent)
                    os.close(fd)
                    temporary = Path(filename)
                    current[0].savev(filename, "png", [], [])
                    rendered = temporary
                if action == 1:
                    if save_as(rendered):
                        break
                else:
                    with rendered.open("rb") as stream:
                        subprocess.Popen(["wl-copy", "--foreground", "--paste-once",
                                          "--sensitive", "--type", "image/png"],
                                         stdin=stream, stdout=subprocess.DEVNULL,
                                         stderr=subprocess.DEVNULL, start_new_session=True)
                    break
            except OSError as error:
                notify("Não foi possível concluir: " + str(error))
            finally:
                if temporary:
                    temporary.unlink(missing_ok=True)
    finally:
        if resize_idle[0]: GLib.source_remove(resize_idle[0])
        window.destroy()
        Gtk.StyleContext.remove_provider_for_screen(window.get_screen(), provider)


def main():
    cache = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "apx-screenshots"
    cache.mkdir(parents=True, exist_ok=True, mode=0o700)
    logging.basicConfig(filename=str(cache / "capture.log"), level=logging.INFO,
                        format="%(asctime)s %(message)s")
    logging.info("Capture requested pid=%s", os.getpid())
    lock = (cache / "capture.lock").open("w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        logging.info("Skipped: capture window or preview already active")
        lock.close()
        return 0

    fd, filename = tempfile.mkstemp(suffix=".png", prefix="capture-", dir=cache)
    os.close(fd)
    source = Path(filename)
    try:
        if subprocess.run(["grim", filename], check=False).returncode:
            notify("Não foi possível capturar o ecrã.")
            return 1
        logging.info("PNG captured: %s bytes", source.stat().st_size)
        pictures = Path.home() / "Pictures" / "Screenshots"
        pictures.mkdir(mode=0o700, parents=True, exist_ok=True)
        stamp = datetime.datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
        descriptor, saved_name = tempfile.mkstemp(prefix="Screenshot_" + stamp + "_",
                                                 suffix=".png", dir=pictures)
        os.close(descriptor)
        saved = Path(saved_name)
        try:
            shutil.copyfile(source, saved)
        except OSError:
            saved.unlink(missing_ok=True)
            raise
        logging.info("Saved screenshot: %s (%s bytes)", saved, saved.stat().st_size)
        subprocess.Popen(["quickshell", "-c", "apx", "ipc", "call", "host", "hotkeyScreenshot"],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        result = subprocess.run([
            "notify-send", "-a", "APX Captura", "-t", "5000", "-i", filename,
            "-h", "string:image-path:" + filename,
            "-A", "default=Abrir captura",
            "Captura de ecrã", "Guardada em Imagens/Capturas"
        ], capture_output=True, text=True, check=False, timeout=8)
        logging.info("Notification result=%s action=%r error=%r", result.returncode, result.stdout.strip(), result.stderr.strip())
        if result.stdout.strip() == "default":
            expand(source)
        return 0
    except Exception:
        logging.exception("Capture failed")
        notify("Não foi possível concluir a captura de ecrã.")
        return 1
    finally:
        source.unlink(missing_ok=True)
        lock.close()


if __name__ == "__main__":
    raise SystemExit(main())
