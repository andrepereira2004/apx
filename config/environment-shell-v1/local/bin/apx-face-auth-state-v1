#!/usr/bin/python3
"""UI-only facial capture status, scoped to the invoking lock's process tree.

This helper never authenticates, reads credentials, or controls the camera.
Absent evidence produces neutral instructions, never an inferred failure.
"""
import configparser
import os
from pathlib import Path
import re
import stat
import time

COMPARE = '/usr/lib/howdy/compare.py'


def process(pid, proc=Path('/proc')):
    try:
        path = proc/str(pid)
        # comm may contain spaces or parentheses: fields start after the last ).
        fields = (path/'stat').read_text().rsplit(')', 1)[1].split()
        return dict(pid=int(pid), parent=int(fields[1]), start=int(fields[19]),
                    comm=(path/'comm').read_text().strip(), uid=path.stat().st_uid)
    except (OSError, ValueError, IndexError):
        return None


def lock_ancestor(pid, proc=Path('/proc')):
    seen = set()
    for _ in range(32):
        if pid <= 1 or pid in seen:
            break
        seen.add(pid)
        current = process(pid, proc)
        if not current:
            break
        if current['comm'] == 'hyprlock':
            return current
        pid = current['parent']
    return None


def face_available(root=Path('/')):
    try:
        for relative in ('usr/lib/security/pam_howdy.so', 'etc/howdy/models/apx.dat'):
            if not os.access(root/relative, os.R_OK):
                return False
        pam = (root/'etc/pam.d/hyprlock').read_text()
        if not re.search(r'^\s*auth\s+[^\n]*\bpam_howdy\.so\b', pam, re.M):
            return False
        config = configparser.ConfigParser()
        config.read(root/'etc/howdy/config.ini')
        return not config.getboolean('core', 'disabled', fallback=True)
    except (OSError, ValueError, configparser.Error):
        return False


def capture_state(lock, runtime, proc=Path('/proc'), now=None):
    if not lock:
        return 'ready'
    now = time.time() if now is None else now
    candidates = []
    try:
        entries = list(proc.iterdir())
    except OSError:
        return 'ready'
    for entry in entries:
        if not entry.name.isdecimal():
            continue
        try:
            args = (entry/'cmdline').read_bytes().split(b'\0')
            if COMPARE.encode() not in args:
                continue
            current = process(int(entry.name), proc)
            ancestor = lock_ancestor(int(entry.name), proc)
            if not current or not ancestor or (ancestor['pid'], ancestor['start']) != (lock['pid'], lock['start']):
                continue
            marker = runtime/f"apx-howdy-camera-{current['pid']}-{current['start']}.active"
            state = 'preparing'
            try:
                metadata = marker.lstat()
                if stat.S_ISREG(metadata.st_mode) and metadata.st_uid == current['uid'] and not metadata.st_mode & 0o077:
                    state = 'capturing' if 0 <= now - metadata.st_mtime <= 2 else 'waiting_frame'
            except OSError:
                pass
            candidates.append((current['start'], state))
        except OSError:
            continue
    return max(candidates)[1] if candidates else 'ready'


def message(state):
    return {
        'password': 'Desbloqueia com a tua palavra-passe.',
        'ready': 'Palavra-passe ou Enter vazio para tentar o rosto.',
        'preparing': 'A preparar o reconhecimento facial…',
        'capturing': 'A procurar o teu rosto…',
        'waiting_frame': 'A aguardar imagem da câmara…',
    }[state]


def main():
    if not face_available():
        print(message('password'))
        return
    runtime = Path(os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}'))
    print(message(capture_state(lock_ancestor(os.getppid()), runtime)))


if __name__ == '__main__':
    main()
