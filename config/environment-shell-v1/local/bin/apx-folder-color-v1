#!/usr/bin/env python3
"""Environment-local folder colors and Tumbler thumbnails, without shell commands."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import tempfile

MARKER = '.apx-folder-color'
COLORS = [('Predefinida', ''), ('Azul', '#79baff'), ('Verde', '#78c99c'),
          ('Amarelo', '#edce72'), ('Laranja', '#efa56b'), ('Vermelho', '#e98181'),
          ('Rosa', '#e995c5'), ('Roxo', '#b39ae8')]


def folder(path):
    path = Path(path).absolute()
    if path.is_symlink() or not path.is_dir():
        raise ValueError('Escolha uma pasta local, sem ligação simbólica.')
    return path


TAGS_MARKER = '.apx-folder-tags'


def read_tags(path):
    marker = folder(path) / TAGS_MARKER
    try:
        if marker.is_symlink() or marker.stat().st_size > 8192:
            return []
        tags = json.loads(marker.read_text())
        if isinstance(tags, list) and len(tags) <= 20 and all(isinstance(t, str) and 0 < len(t) <= 64 and not any(ord(c) < 32 for c in t) for t in tags):
            return tags
    except (OSError, ValueError):
        pass
    return []


def normalize_tags(text):
    tags = list(dict.fromkeys(t.strip() for t in text.split(',') if t.strip()))
    if len(tags) > 20 or any(len(t) > 64 or any(ord(c) < 32 for c in t) for t in tags):
        raise ValueError('Usa até 20 etiquetas, com até 64 caracteres cada.')
    return tags


def set_tags(path, text):
    path = folder(path)
    tags = normalize_tags(text)
    marker = path / TAGS_MARKER
    if marker.is_symlink() or (marker.exists() and not marker.is_file()):
        raise ValueError('Não foi possível guardar as etiquetas nesta pasta.')
    if not tags:
        marker.unlink(missing_ok=True)
        invalidate_thumbnail(path)
        return
    fd, temporary = tempfile.mkstemp(prefix=TAGS_MARKER + '-', dir=path)
    try:
        with os.fdopen(fd, 'w') as stream:
            json.dump(tags, stream, ensure_ascii=False)
        os.replace(temporary, marker)
    finally:
        Path(temporary).unlink(missing_ok=True)
    invalidate_thumbnail(path)


def valid_name(name):
    name = name.strip()
    if not name or name in ('.', '..') or '/' in name or '\0' in name:
        raise ValueError('Introduza um nome de pasta válido.')
    return name


def set_color(path, color):
    path = folder(path)
    if color not in dict(COLORS).values():
        raise ValueError('Cor inválida.')
    marker = path / MARKER
    if marker.is_symlink() or (marker.exists() and not marker.is_file()):
        raise ValueError('Não foi possível guardar a cor nesta pasta.')
    if color:
        fd, temporary = tempfile.mkstemp(prefix=MARKER + '-', dir=path)
        try:
            with os.fdopen(fd, 'w') as stream:
                stream.write(color + '\n')
            os.replace(temporary, marker)
        finally:
            Path(temporary).unlink(missing_ok=True)
    else:
        marker.unlink(missing_ok=True)
    invalidate_thumbnail(path)


def invalidate_thumbnail(path):
    # Invalidate only this directory's own thumbnail, including failure cache.
    digest = hashlib.md5(path.as_uri().encode(), usedforsecurity=False).hexdigest() + '.png'
    cache = Path(os.environ.get('XDG_CACHE_HOME', str(Path.home() / '.cache'))) / 'thumbnails'
    for size in ('normal', 'large', 'x-large', 'xx-large', 'fail/gnome-thumbnail-factory', 'fail/tumbler'):
        (cache / size / digest).unlink(missing_ok=True)
    # Changing directory mtime makes Tumbler regenerate an existing thumbnail.
    os.utime(path, None)


def thumbnail(path, output, size):
    path = folder(path)
    marker = path / MARKER
    color = ''
    if marker.is_file() and not marker.is_symlink():
        color = marker.read_text().strip()
    if color not in dict(COLORS).values():
        color = ''
    tagged = bool(read_tags(path))
    if not color and not tagged:
        return 1
    render_icon(color or '#adc0cc', size, tagged=tagged).write_to_png(str(output))
    return 0


def render_icon(color, size, tagged=False):
    import cairo
    size = max(16, min(int(size), 1024))
    surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, size, size)
    ctx = cairo.Context(surface)
    draw_icon(ctx, color, size, tagged=tagged)
    return surface


def draw_icon(ctx, color, size, tagged=False):
    """Draw vector paths into the target context at its native device scale."""
    import cairo
    ctx.save()
    ctx.scale(size / 48, size / 48)
    rgb = tuple(int(color[i:i+2], 16) / 255 for i in (1, 3, 5))
    ctx.move_to(8, 9)
    ctx.line_to(19, 9)
    ctx.line_to(23, 14)
    ctx.line_to(40, 14)
    ctx.curve_to(42, 14, 43, 15, 43, 17)
    ctx.line_to(43, 37)
    ctx.curve_to(43, 39, 42, 40, 40, 40)
    ctx.line_to(8, 40)
    ctx.curve_to(6, 40, 5, 39, 5, 37)
    ctx.line_to(5, 12)
    ctx.curve_to(5, 10, 6, 9, 8, 9)
    ctx.set_source_rgb(*(v * .78 for v in rgb))
    ctx.fill()
    ctx.move_to(8, 16)
    ctx.line_to(40, 16)
    ctx.curve_to(42, 16, 43, 17, 43, 19)
    ctx.line_to(43, 37)
    ctx.curve_to(43, 39, 42, 40, 40, 40)
    ctx.line_to(8, 40)
    ctx.curve_to(6, 40, 5, 39, 5, 37)
    ctx.line_to(5, 19)
    ctx.curve_to(5, 17, 6, 16, 8, 16)
    ctx.set_source_rgb(*rgb)
    ctx.fill()
    ctx.move_to(9, 17)
    ctx.line_to(39, 17)
    ctx.set_source_rgba(1, 1, 1, .45)
    ctx.set_line_width(1.5)
    ctx.set_line_cap(cairo.LINE_CAP_ROUND)
    ctx.stroke()
    if tagged:
        ctx.set_source_rgb(.06, .10, .14)
        ctx.arc(39, 35, 9, 0, 6.283185307)
        ctx.fill()
        ctx.set_source_rgb(.47, .73, 1)
        ctx.set_line_width(1.5)
        ctx.set_line_join(cairo.LINE_JOIN_ROUND)
        ctx.move_to(34, 30)
        ctx.line_to(40, 30)
        ctx.line_to(44, 34)
        ctx.line_to(38, 40)
        ctx.line_to(34, 36)
        ctx.close_path()
        ctx.stroke()
        ctx.arc(37, 33, .85, 0, 6.283185307)
        ctx.fill()
    ctx.restore()


def dialog(paths, tags_only=False):
    import gi
    gi.require_version('Gtk', '3.0')
    gi.require_version('GtkLayerShell', '0.1')
    from gi.repository import Gtk, Gdk, GtkLayerShell, Pango
    paths = [folder(path) for path in paths]
    window = Gtk.Dialog(title='Editar etiquetas' if tags_only else 'Cor da pasta')
    window.set_resizable(False)
    window.set_decorated(False)
    window.set_skip_taskbar_hint(True)
    window.set_skip_pager_hint(True)
    window.set_name('apx-folder-palette')
    window.set_app_paintable(True)
    visual = window.get_screen().get_rgba_visual()
    if visual is not None:
        window.set_visual(visual)
    if GtkLayerShell.is_supported():
        GtkLayerShell.init_for_window(window)
        GtkLayerShell.set_namespace(window, 'apx-folder-palette')
        GtkLayerShell.set_layer(window, GtkLayerShell.Layer.OVERLAY)
        GtkLayerShell.set_exclusive_zone(window, -1)
        GtkLayerShell.set_keyboard_mode(window, GtkLayerShell.KeyboardMode.EXCLUSIVE)
        for edge in (GtkLayerShell.Edge.TOP, GtkLayerShell.Edge.BOTTOM,
                     GtkLayerShell.Edge.LEFT, GtkLayerShell.Edge.RIGHT):
            GtkLayerShell.set_anchor(window, edge, True)
    else:
        window.set_keep_above(True)
        window.fullscreen()
    box = window.get_content_area()
    box.set_border_width(0)
    card = Gtk.EventBox()
    card.set_name('apx-folder-palette-card')
    card.set_border_width(0)
    card.set_halign(Gtk.Align.CENTER)
    card.set_valign(Gtk.Align.CENTER)
    content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
    content.set_margin_start(10)
    content.set_margin_end(10)
    content.set_margin_top(10)
    content.set_margin_bottom(10)
    card.add(content)
    wrapper = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
    wrapper.set_hexpand(True)
    wrapper.set_vexpand(True)
    wrapper.set_center_widget(card)
    box.pack_start(wrapper, True, True, 0)
    style = Gtk.CssProvider()
    style.load_from_data(b"""
        #apx-folder-palette.background,
        #apx-folder-palette > box { background-color: transparent; background-image: none; box-shadow: none; }
        #apx-folder-palette-card { background-color: rgba(10, 16, 20, 0.75); border: 1px solid rgba(120, 145, 160, 0.24); border-radius: 12px; }
        #apx-folder-palette-card button { padding: 5px 9px; border-radius: 8px; background-color: rgba(25, 29, 34, 0.7); background-image: none; color: #eceef0; border: 1px solid #343a41; box-shadow: none; text-shadow: none; }
        #apx-folder-palette-card button:hover,
        #apx-folder-palette-card button:focus { background-color: rgba(39, 44, 51, 0.8); border-color: rgba(121, 186, 255, 0.4); }
        #apx-folder-palette-card .folder-swatch { padding: 4px; min-width: 0; min-height: 0; background-color: transparent; border-color: transparent; }
        #apx-folder-palette-card .folder-swatch.suggested-action { background-color: rgba(48, 53, 59, 0.75); border-color: #343a41; }
        #apx-folder-palette-card label { color: #eceef0; }
        #apx-folder-palette-card entry { background-color: rgba(25, 29, 34, 0.8); background-image: none; color: #eceef0; border: 1px solid #343a41; border-radius: 8px; padding: 6px 9px; box-shadow: none; }
        #apx-folder-palette-card entry:focus { border-color: #79baff; }
        #apx-folder-palette-card flowboxchild { padding: 0; background-color: transparent; }
        #apx-folder-palette-card .tag-chip { background-color: rgba(25, 29, 34, 0.75); border: 1px solid #343a41; border-radius: 8px; padding: 2px 5px; }
    """)
    Gtk.StyleContext.add_provider_for_screen(window.get_screen(), style, Gtk.STYLE_PROVIDER_PRIORITY_USER + 1)
    error_label = Gtk.Label(wrap=True, xalign=0)
    error_label.set_max_width_chars(32)
    def error_message(error):
        error_label.set_text(str(error))
        error_label.show()
    window.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
    def outside_click(widget, event):
        source = Gtk.get_event_widget(event) or window
        point = source.translate_coordinates(card, int(event.x), int(event.y))
        if point is None or not (0 <= point[0] < card.get_allocated_width()
                                 and 0 <= point[1] < card.get_allocated_height()):
            window.response(Gtk.ResponseType.CANCEL)
            return True
        return False
    window.connect('button-press-event', outside_click)
    window.connect('key-press-event', lambda widget, event:
        (window.response(Gtk.ResponseType.CANCEL) or True) if event.keyval == Gdk.KEY_Escape else False)

    if tags_only:
        content.set_size_request(280, -1)
        content.add(Gtk.Label(label='Etiquetas', xalign=0))
        tags = read_tags(paths[0]) if len(paths) == 1 else []
        flow = Gtk.FlowBox()
        flow.set_selection_mode(Gtk.SelectionMode.NONE)
        flow.set_column_spacing(5)
        flow.set_row_spacing(5)
        flow.set_max_children_per_line(3)
        scroller = Gtk.ScrolledWindow()
        scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroller.set_propagate_natural_height(True)
        scroller.set_max_content_height(160)
        scroller.add(flow)
        content.add(scroller)
        def refresh_chips():
            for child in flow.get_children():
                flow.remove(child)
            for tag in tags:
                row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
                chip = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
                chip.get_style_context().add_class('tag-chip')
                label = Gtk.Label(label=tag)
                label.set_max_width_chars(14)
                label.set_ellipsize(Pango.EllipsizeMode.END)
                label.set_tooltip_text(tag)
                label.set_xalign(0)
                chip.pack_start(label, True, True, 0)
                remove = Gtk.Button(label='×')
                remove.set_valign(Gtk.Align.FILL)
                remove.set_tooltip_text('Remover ' + tag)
                remove.get_accessible().set_name('Remover etiqueta ' + tag)
                def remove_tag(button, value=tag):
                    tags.remove(value)
                    refresh_chips()
                remove.connect('clicked', remove_tag)
                row.pack_start(chip, True, True, 0)
                row.pack_end(remove, False, False, 0)
                flow.add(row)
            flow.show_all()
        refresh_chips()
        input_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        entry = Gtk.Entry()
        entry.set_placeholder_text('Adicionar etiqueta')
        entry.set_width_chars(22)
        input_row.pack_start(entry, True, True, 0)
        add = Gtk.Button(label='+')
        add.set_tooltip_text('Adicionar etiqueta')
        input_row.add(add)
        def add_tags(widget):
            try:
                new = normalize_tags(','.join(tags + [entry.get_text()]))
                tags[:] = new
                entry.set_text('')
                error_label.hide()
                refresh_chips()
            except ValueError as error:
                error_message(error)
        add.connect('clicked', add_tags)
        entry.connect('activate', add_tags)
        content.add(input_row)
        if len(paths) > 1:
            content.add(Gtk.Label(label='Substitui as etiquetas das pastas selecionadas.', wrap=True))
        buttons = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        buttons.set_halign(Gtk.Align.END)
        for text, response in [('Cancelar', Gtk.ResponseType.CANCEL), ('Guardar', Gtk.ResponseType.OK)]:
            button = Gtk.Button(label=text)
            button.connect('clicked', lambda widget, value=response: window.response(value))
            buttons.add(button)
        content.add(buttons)
    else:
        grid = Gtk.Grid(column_spacing=4, row_spacing=4)
        content.add(grid)
        selected = ''
        if len(paths) == 1:
            marker = paths[0] / MARKER
            if marker.is_file() and not marker.is_symlink():
                selected = marker.read_text().strip()
        def choose(button, color):
            try:
                for path in paths:
                    set_color(path, color)
                window.response(Gtk.ResponseType.OK)
            except (OSError, ValueError) as error:
                error_message(error)
        for i, (name, color) in enumerate(COLORS):
            button = Gtk.Button()
            context = button.get_style_context()
            context.add_class('folder-swatch')
            if color == selected:
                context.add_class('suggested-action')
            button.set_relief(Gtk.ReliefStyle.NONE)
            button.set_tooltip_text('Repor cor predefinida' if not color else name)
            button.get_accessible().set_name('Repor cor predefinida' if not color else name)
            drawing = Gtk.DrawingArea()
            drawing.set_size_request(40, 40)
            def draw(widget, context, shade=color or '#adc0cc'):
                draw_icon(context, shade, 40)
                return False
            drawing.connect('draw', draw)
            button.add(drawing)
            button.connect('clicked', choose, color)
            grid.attach(button, i % 4, i // 4, 1, 1)
    content.add(error_label)
    window.show_all()
    window.get_action_area().hide()
    error_label.hide()
    if tags_only:
        entry.grab_focus()
    while window.run() == Gtk.ResponseType.OK:
        if not tags_only:
            break
        try:
            text = ','.join(tags + [entry.get_text()])
            for path in paths:
                set_tags(path, text)
            break
        except (OSError, ValueError) as error:
            error_message(error)
    window.destroy()


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('mode', choices=('set', 'tags', 'search', 'thumbnail'))
    parser.add_argument('paths', nargs='+')
    args = parser.parse_args()
    if args.mode == 'search':
        import shlex
        import subprocess
        root = folder(args.paths[0])
        command = '/home/apx/.local/bin/apx-rofi-files-v1 --tags-only --root ' + shlex.quote(str(root))
        return subprocess.call(['rofi', '-modi', 'etiquetas:' + command,
            '-show', 'etiquetas', '-display-etiquetas', 'Etiquetas', '-show-icons'])
    if args.mode == 'thumbnail':
        if len(args.paths) != 3:
            parser.error('thumbnail requires input, output and size')
        return thumbnail(*args.paths)
    dialog(args.paths, tags_only=args.mode == 'tags')
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
