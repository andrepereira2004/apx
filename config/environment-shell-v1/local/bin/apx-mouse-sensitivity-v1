#!/usr/bin/env python3
"""Set and persist external mouse pointer sensitivity in this Environment."""

import json
import os
from pathlib import Path
import re
import subprocess
import sys

HYPRCTL = "/usr/bin/hyprctl"
CONFIG = Path.home() / ".config/hypr/apx-mouse-sensitivity.lua"
MARKER = re.compile(r"^-- APX mouse sensitivity: (-?\d+(?:\.\d+)?)$", re.MULTILINE)


def current() -> float:
    try:
        match = MARKER.search(CONFIG.read_text(encoding="utf-8"))
        return float(match.group(1)) if match else 0.0
    except (OSError, ValueError):
        return 0.0


def mice() -> list[str]:
    result = subprocess.run((HYPRCTL, "-j", "devices"), capture_output=True, text=True, check=True, timeout=3)
    devices = json.loads(result.stdout)
    if type(devices) is not dict or type(devices.get("mice")) is not list:
        raise RuntimeError("Lista de ratos indisponível")
    return sorted({item["name"] for item in devices["mice"]
                   if type(item) is dict and type(item.get("name")) is str
                   and re.fullmatch(r"[A-Za-z0-9 _.,:-]{1,128}", item["name"])
                   and "touchpad" not in item["name"].lower()})


def set_value(value: float) -> None:
    if not -1.0 <= value <= 1.0:
        raise ValueError("A sensibilidade tem de estar entre -1 e 1")
    names = mice()
    if not names:
        raise RuntimeError("Nenhum rato externo está ligado")
    if CONFIG.exists() and not MARKER.search(CONFIG.read_text(encoding="utf-8")):
        raise RuntimeError("Já existe uma configuração de rato que não pertence à APX")
    rendered = "-- APX mouse sensitivity: %.2f\n" % value
    for name in names:
        code = "hl.device({name=" + json.dumps(name) + ", sensitivity=%.2f})" % value
        result = subprocess.run((HYPRCTL, "eval", code), capture_output=True, text=True,
                                check=False, timeout=3)
        if result.returncode or result.stdout.strip() != "ok":
            raise RuntimeError("O compositor recusou a alteração do rato")
        rendered += code + "\n"
    CONFIG.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    temporary = CONFIG.with_name(CONFIG.name + f".{os.getpid()}.tmp")
    try:
        with temporary.open("x", encoding="utf-8") as stream:
            os.chmod(temporary, 0o600)
            stream.write(rendered)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, CONFIG)
    finally:
        temporary.unlink(missing_ok=True)


if __name__ == "__main__":
    try:
        if sys.argv[1:] == ["get"]:
            print(round(current() * 100))
        elif len(sys.argv) == 3 and sys.argv[1] == "set":
            value = int(sys.argv[2])
            if not -100 <= value <= 100:
                raise ValueError("Valor fora do intervalo")
            set_value(value / 100)
            print(value)
        else:
            raise ValueError("Uso: apx-mouse-sensitivity-v1 get|set VALOR")
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError, json.JSONDecodeError) as error:
        print(str(error), file=sys.stderr)
        raise SystemExit(2)
