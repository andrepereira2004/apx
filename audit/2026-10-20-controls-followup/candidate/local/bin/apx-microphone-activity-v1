#!/usr/bin/env python3
"""Read capture activity from this Environment's PipeWire graph."""
import json
from pathlib import Path
import subprocess
import sys


def active(nodes):
    return any(isinstance(node, dict)
               and node.get('type') == 'PipeWire:Interface:Node'
               and node.get('info', {}).get('state') == 'running'
               and node.get('info', {}).get('props', {}).get('media.class') in
                   ('Audio/Source', 'Stream/Input/Audio')
               for node in nodes)


def camera_enabled(root=Path('/sys')):
    # Physical video devices disappear when the laptop's privacy key disables
    # the camera. Ignore virtual cameras created by streaming applications.
    devices = root / 'class/video4linux'
    if not (root / 'class').is_dir():
        return None
    return any((device / 'device').exists() for device in devices.glob('video*'))


def camera_active(nodes, root=Path('/sys'), proc=Path('/proc')):
    # Read metadata only: never open a camera, capture a frame or inspect file contents.
    devices = {device.name for device in (root / 'class/video4linux').glob('video*')
               if (device / 'device').exists()}
    for node in nodes:
        info = (node.get('info') or {}) if isinstance(node, dict) else {}
        props = info.get('props') or {}
        path = str(props.get('api.v4l2.path', ''))
        if info.get('state') == 'running' and path.startswith('/dev/') and path.rsplit('/', 1)[-1] in devices:
            return True
    if not devices: return False
    for process in proc.iterdir():
        if not process.name.isdecimal(): continue
        try:
            for fd in (process / 'fd').iterdir():
                try: target = str(fd.readlink())
                except OSError: continue
                if target.startswith('/dev/') and target[5:] in devices:
                    return True
        except OSError:
            continue
    return False


def main():
    report = {'camera_enabled': camera_enabled()}
    nodes = []
    try:
        result = subprocess.run(['/usr/bin/pw-dump'], capture_output=True, text=True,
                                check=True, timeout=1)
        nodes = json.loads(result.stdout)
        if not isinstance(nodes, list):
            raise ValueError('Invalid PipeWire graph')
        report['microphone_active'] = active(nodes)
    except (OSError, ValueError, subprocess.SubprocessError):
        # Camera privacy feedback must also work when audio is unavailable.
        report['microphone_active'] = False
    report['camera_active'] = camera_active(nodes)
    print(json.dumps(report))


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, subprocess.SubprocessError):
        print('Microphone activity unavailable', file=sys.stderr)
        sys.exit(1)
