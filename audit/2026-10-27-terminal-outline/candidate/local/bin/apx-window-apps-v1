    'xgpsspeed': 'GPS — velocidade (xgpsspeed)',
    'avahi-discover': 'Descobrir serviços de rede (Avahi)',
    'bssh': 'Ligações SSH na rede (Avahi)',
    'bvnc': 'Ligações VNC na rede (Avahi)',
    'qv4l2': 'Diagnóstico de câmara (qv4l2)',
    'qvidcap': 'Captura de vídeo (qvidcap)',
    'lstopo': 'Topologia do hardware (lstopo)',
    'cmake-gui': 'Configuração de projetos CMake',
    'rofi': 'Rofi', 'rofi-theme-selector': 'Temas do Rofi',
    'org.quickshell': 'QuickShell',
    'foot': 'Terminal Foot', 'foot-server': 'Servidor do terminal Foot',
    'footclient': 'Cliente do terminal Foot', 'Alacritty': 'Terminal Alacritty',
    'kitty-open': 'Abrir com Kitty',
    'cups': 'Administração de impressão (CUPS)',
    'system-config-printer': 'Configurar impressoras',
    'thunar-bulk-rename': 'Renomear vários ficheiros',
    'thunar-settings': 'Preferências do gestor de ficheiros',
    'org.xfce.mousepad-settings': 'Preferências do editor de texto',
    'xfce4-about': 'Sobre os componentes Xfce',
    'org.gnome.Evince-previewer': 'Pré-visualização de impressão',
    'gcr-viewer': 'Ver certificados', 'uuctl': 'Serviços da sessão (uuctl)',
