#!/usr/bin/env python3
"""Session-local pointer switches; never disable the last available pointer group."""
import fcntl,json,os,subprocess,sys
from pathlib import Path

def groups(devices):
    names={d['name'] for d in devices.get('mice',[]) if isinstance(d,dict) and isinstance(d.get('name'),str)}
    pads={n for n in names if 'touchpad' in n.lower() or 'trackpad' in n.lower()}
    companions={n.rsplit('-',1)[0]+'-mouse' for n in pads}
    return {'trackpad':sorted(pads),'mouse':sorted(n for n in names-pads-companions if 'keyboard' not in n.lower())}

def apply(names,enabled):
    for name in names:
        code='hl.device({name='+json.dumps(name)+',enabled='+str(enabled).lower()+'})'
        r=subprocess.run(['/usr/bin/hyprctl','eval',code],capture_output=True,text=True,timeout=3)
        if r.returncode or r.stdout.strip()!='ok':raise RuntimeError('Não foi possível alterar o dispositivo.')

def switch(state,devices,kind):
    other='mouse' if kind=='trackpad' else 'trackpad'
    if not devices[kind]:raise RuntimeError('Dispositivo não disponível.')
    enabled=not state.get(kind,True)
    if not enabled:
        if not devices[other]:raise RuntimeError('É necessário manter um rato ou trackpad ativo.')
        # Explicitly enable the fallback before disabling anything, including
        # when an independent hardware hotkey previously disabled it.
        apply(devices[other],True);state[other]=True
    try:apply(devices[kind],enabled)
    except Exception:
        apply(devices[kind],True);state[kind]=True
        raise
    state[kind]=enabled
    return state

def recover(state, devices):
    # Restore the built-in pointer if the external fallback is unplugged.
    for kind,other in [('trackpad','mouse'),('mouse','trackpad')]:
        if devices[kind] and not devices[other] and not state.get(kind,True):
            apply(devices[kind],True);state[kind]=True

def main():
    args=sys.argv[1:]
    if args!=['status'] and not(len(args)==2 and args[0]=='toggle' and args[1] in ['mouse','trackpad']):raise ValueError('Pedido inválido.')
    runtime=Path(os.environ['XDG_RUNTIME_DIR'])/'apx-pointer-power-v1';runtime.mkdir(mode=0o700,exist_ok=True)
    with (runtime/'lock').open('a') as lock:
        fcntl.flock(lock,fcntl.LOCK_EX)
        path=runtime/'state.json';signature=os.environ.get('HYPRLAND_INSTANCE_SIGNATURE','')
        try:state=json.loads(path.read_text())
        except (OSError,ValueError):state={}
        if state.get('session')!=signature:state={'session':signature,'mouse':True,'trackpad':True}
        r=subprocess.run(['/usr/bin/hyprctl','devices','-j'],capture_output=True,text=True,check=True,timeout=3)
        devices=groups(json.loads(r.stdout))
        try:
            recover(state,devices)
            if args[0]=='toggle':switch(state,devices,args[1])
        finally:
            temp=path.with_suffix('.tmp');temp.write_text(json.dumps(state));os.chmod(temp,0o600);os.replace(temp,path)
        print(json.dumps({k:{'available':bool(devices[k]),'enabled':bool(devices[k]) and state.get(k,True)} for k in devices}))
if __name__=='__main__':
    try:main()
    except (OSError,ValueError,RuntimeError,subprocess.SubprocessError) as e:
        print(str(e),file=sys.stderr);sys.exit(2)
