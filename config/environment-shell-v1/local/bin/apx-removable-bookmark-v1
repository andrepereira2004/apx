#!/usr/bin/env python3
"""Show the physical-pilot USB bridge in GTK bookmarks only while mounted."""
import argparse
import fcntl
import os
from pathlib import Path
import tempfile
import time

VOLUME = Path('/media/apx-usb/Ventoy')
URI = 'file:///media/apx-usb/Ventoy'
LEGACY_URI = 'file:///media/apx-usb'


def refresh(bookmarks=None, present=None):
    bookmarks = bookmarks or Path.home() / '.config/gtk-3.0/bookmarks'
    if bookmarks.is_symlink():
        raise ValueError('Refusing linked bookmark file')
    present = os.path.ismount(VOLUME) if present is None else present
    old = bookmarks.read_text() if bookmarks.exists() else ''
    lines = [line for line in old.splitlines()
             if line.split(' ', 1)[0] not in (URI, LEGACY_URI)]
    if present:
        lines.append(URI + ' PEN USB')
    new = '\n'.join(lines) + ('\n' if lines else '')
    if old == new:
        return False
    bookmarks.parent.mkdir(parents=True, exist_ok=True)
    metadata = bookmarks.stat() if bookmarks.exists() else None
    fd, temporary = tempfile.mkstemp(prefix='.apx-usb-bookmark-', dir=bookmarks.parent)
    try:
        with os.fdopen(fd, 'w') as stream:
            stream.write(new)
        if metadata:
            os.chmod(temporary, metadata.st_mode & 0o777)
        os.replace(temporary, bookmarks)
    finally:
        Path(temporary).unlink(missing_ok=True)
    return True


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--watch', action='store_true')
    args = parser.parse_args()
    state = Path.home() / '.local/state/apx-removable-bookmark-v1'
    state.mkdir(parents=True, exist_ok=True)
    with (state / 'watch.lock').open('a') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return
        while True:
            try:
                refresh()
            except (OSError, ValueError) as error:
                print('APX USB bookmark: ' + str(error), flush=True)
            if not args.watch:
                break
            time.sleep(2)


if __name__ == '__main__':
    main()
