[Unit]
Description=Recover failed APX virtual network links
After=systemd-networkd.service
ConditionPathExists=/usr/lib/apx/apx-network-recovery-v1.py

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/lib/apx/apx-network-recovery-v1.py
TimeoutStartSec=90
RuntimeDirectory=apx-network-recovery-v1
RuntimeDirectoryPreserve=yes
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
