+#[cfg(test)]
+#[allow(clippy::unwrap_used)]
+mod async_open_tests {
+    use super::*;
+    use std::sync::mpsc::channel;
+    use std::sync::{Arc, Mutex};
+
+    #[test]
+    fn waiting_and_cancel_do_not_block_or_change_the_workbook() {
+        let mut session = Session::new();
+        session.new_workbook();
+        let uid = session.active().unwrap().uid;
+        let (tx, rx) = channel();
+        let receiver = Arc::new(Mutex::new(Some(rx)));
+        let calls = Arc::new(std::sync::atomic::AtomicUsize::new(0));
+        let seen = calls.clone();
+        let services = Services {
+            pick_open_async: Some(Box::new(move || {
+                seen.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+                receiver.lock().unwrap().take().unwrap()
+            })),
+            ..Default::default()
+        };
+        let mut app = SheetApp::new(session, services);
+        app.open_dialog("open", json!({}));
+        app.open_dialog("open", json!({}));
+        app.poll_open_dialog();
+        assert!(app.pending_open.is_some());
+        assert_eq!(calls.load(std::sync::atomic::Ordering::Relaxed), 1);
+        assert_eq!(app.session.active().unwrap().uid, uid);
+        tx.send(Ok(None)).unwrap();
+        app.poll_open_dialog();
+        assert!(app.pending_open.is_none());
+        assert_eq!(app.session.active().unwrap().uid, uid);
+        assert!(app.message.is_none());
+    }
+
+    #[test]
+    fn a_failed_picker_releases_the_pending_state_and_reports_the_error() {
+        let mut app = SheetApp::new(Session::new(), Services::default());
+        let (tx, rx) = channel();
+        app.pending_open = Some(rx);
+        drop(tx);
+        app.poll_open_dialog();
+        assert!(app.pending_open.is_none());
+        assert!(app.message.is_some());
+    }
+
+    #[test]
+    fn a_selected_missing_file_reports_an_error_without_replacing_the_workbook() {
+        let mut session = Session::new();
+        session.new_workbook();
+        let uid = session.active().unwrap().uid;
+        let mut app = SheetApp::new(session, Services::default());
+        let (tx, rx) = channel();
+        app.pending_open = Some(rx);
+        tx.send(Ok(Some("/nonexistent-apx-picker-test/workbook.xlsx".into()))).unwrap();
+        app.poll_open_dialog();
+        assert!(app.pending_open.is_none());
+        assert_eq!(app.session.active().unwrap().uid, uid);
+        assert!(app.message.is_some());
+    }
+}
