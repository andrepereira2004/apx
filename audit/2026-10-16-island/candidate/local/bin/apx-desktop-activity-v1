#!/usr/bin/env python3
"""Read local MPRIS/Mako activity; run explicit media and radio actions."""
import json
import re
import subprocess
import sys
import time
import math


def bus():
    import gi
    from gi.repository import Gio
    return Gio.bus_get_sync(Gio.BusType.SESSION, None)


def call(connection, destination, path, interface, method, params=None):
    from gi.repository import Gio
    return connection.call_sync(destination, path, interface, method, params, None,
                                Gio.DBusCallFlags.NONE, 1000, None).unpack()


def players():
    result=[]
    try:
        from gi.repository import GLib
        connection=bus()
        names=call(connection,'org.freedesktop.DBus','/org/freedesktop/DBus','org.freedesktop.DBus','ListNames')[0]
        for name in names:
            if not name.startswith('org.mpris.MediaPlayer2.'):continue
            try:
                props=call(connection,name,'/org/mpris/MediaPlayer2','org.freedesktop.DBus.Properties','GetAll',GLib.Variant('(s)',('org.mpris.MediaPlayer2.Player',)))[0]
                metadata=props.get('Metadata',{});url=str(metadata.get('xesam:url',''))
                title=str(metadata.get('xesam:title',''))[:300] or name.split('org.mpris.MediaPlayer2.',1)[1]
                artist=metadata.get('xesam:artist',[])
                if isinstance(artist,list):artist=', '.join(str(v) for v in artist)
                video=bool(re.search(r'(youtube|youtu\.be|vimeo|\.(mp4|mkv|webm|avi)(\?|$))',url,re.I))
                result.append(dict(name=name,title=title,artist=str(artist)[:300],status=props.get('PlaybackStatus','Stopped'),
                                   kind='video' if video else 'music',
                                   position=max(0, int(props.get('Position',0))) / 1000000,
                                   length=max(0, int(metadata.get('mpris:length',0))) / 1000000,
                                   rate=float(props.get('Rate',1)), sampled_at=time.time()*1000,
                                   track_id=str(metadata.get('mpris:trackid','')),
                                   art_url=str(metadata.get('mpris:artUrl','')) if str(metadata.get('mpris:artUrl','')).startswith('file:///') else '',
                                   can_seek=bool(props.get('CanSeek',False)),can_control=bool(props.get('CanControl',False)),
                                   can_next=bool(props.get('CanGoNext',False)),can_previous=bool(props.get('CanGoPrevious',False))))
            except Exception:continue
    except Exception:pass
    return sorted(result,key=lambda item:item['status']!='Playing')


def notifications():
    result=[];seen=set();active=0
    for action in ('list','history'):
        response=subprocess.run(['/usr/bin/makoctl',action,'-j'],capture_output=True,text=True,timeout=3)
        if response.returncode:continue
        try:data=json.loads(response.stdout or '[]')
        except ValueError:continue
        if isinstance(data,dict):data=data.get('data',[])
        if not isinstance(data,list):continue
        for item in reversed(data[-50:]):
            if not isinstance(item,dict) or type(item.get('id')) is not int or item['id'] in seen:continue
            seen.add(item['id']);active+=action=='list'
            result.append(dict(id=item['id'],app=str(item.get('app_name',item.get('app-name','')) or 'Aplicação')[:120],
                               title=str(item.get('summary',''))[:300],body=str(item.get('body',''))[:2000],active=action=='list'))
    return result[:50],active


def status():
    notes,count=notifications()
    return dict(players=players(),notifications=notes,active_notifications=count)


def main(args):
    if args==['get']:pass
    elif len(args)==3 and args[0]=='media':
        name,action=args[1:]
        if not re.fullmatch(r'org\.mpris\.MediaPlayer2\.[A-Za-z0-9_.-]{1,200}',name):raise ValueError('Reprodutor inválido.')
        methods={'play-pause':'PlayPause','next':'Next','previous':'Previous'}
        if action not in methods:raise ValueError('Ação de reprodução inválida.')
        call(bus(),name,'/org/mpris/MediaPlayer2','org.mpris.MediaPlayer2.Player',methods[action])
    elif len(args)==5 and args[0]=='seek':
        from gi.repository import GLib
        name,track,raw_position,raw_length=args[1:]
        if not re.fullmatch(r'org\.mpris\.MediaPlayer2\.[A-Za-z0-9_.-]{1,200}',name):raise ValueError('Reprodutor inválido.')
        if not re.fullmatch(r'/[A-Za-z0-9_/]+',track) or track.endswith('/NoTrack'):raise ValueError('Faixa inválida.')
        position=float(raw_position);length=float(raw_length)
        if not math.isfinite(position) or not math.isfinite(length) or length<=0 or not 0<=position<=length:raise ValueError('Posição inválida.')
        connection=bus()
        props=call(connection,name,'/org/mpris/MediaPlayer2','org.freedesktop.DBus.Properties','GetAll',GLib.Variant('(s)',('org.mpris.MediaPlayer2.Player',)))[0]
        metadata=props.get('Metadata',{})
        actual_length=max(0,int(metadata.get('mpris:length',0)))/1000000
        if str(metadata.get('mpris:trackid',''))!=track or not props.get('CanSeek',False) or actual_length<=0:raise ValueError('A faixa mudou ou não permite avançar.')
        call(connection,name,'/org/mpris/MediaPlayer2','org.mpris.MediaPlayer2.Player','SetPosition',GLib.Variant('(ox)',(track,int(min(position,actual_length)*1000000))))
    elif len(args)==2 and args[0]=='airplane' and args[1] in ('on','off'):
        result=subprocess.run(['/run/apx/host-services-client-v3.py','radio-airplane',args[1]],capture_output=True,text=True,timeout=10)
        if result.returncode:raise RuntimeError((result.stderr or 'Não foi possível alterar o modo de avião.').strip())
    else:raise ValueError('Ação de atividade inválida.')
    print(json.dumps(status(),ensure_ascii=False))


if __name__=='__main__':
    try:main(sys.argv[1:])
    except Exception as error:print(str(error),file=sys.stderr);sys.exit(1)
