#!/usr/bin/env python3
"""List only the current folder; the native Rofi mode requests it asynchronously."""
import argparse
import configparser
import html
import json
import os
from pathlib import Path
import subprocess
import sys

HOME = Path.home().resolve()
SKIP = {'node_modules', '__pycache__'}


def relative_name(path, directory):
    """Format already-admitted lexical paths without building ancestor Paths."""
    value, root = os.fspath(path), os.fspath(directory)
    if value == root:
        return '.'
    prefix = root.rstrip(os.sep) + os.sep
    if not value.startswith(prefix):
        raise ValueError('Path is outside the search directory')
    return value[len(prefix):]


def current_directory(data):
    try:
        path = Path(data).resolve()
        if path.is_relative_to(HOME) and path.is_dir():
            return path
    except (OSError, ValueError):
        pass
    return HOME


def desktop_entry(path):
    """Application catalogue shortcuts are intentionally linked to vendor files."""
    if path.parent != HOME / 'Applications' or path.suffix != '.desktop':
        return None
    try:
        parser = configparser.ConfigParser(interpolation=None, strict=False)
        # Only tiny launcher metadata is read; large files are never parsed.
        if path.stat().st_size > 131072:
            return None
        with path.open(encoding='utf-8') as source:
            metadata = source.read(131073)
        if len(metadata) > 131072:
            return None
        parser.read_string(metadata)
        item = parser['Desktop Entry']
        if item.get('Type') != 'Application' or item.getboolean('Hidden', fallback=False) or item.getboolean('NoDisplay', fallback=False):
            return None
        return item.get('Name', path.stem), item.get('Icon', 'application-x-executable')
    except (OSError, UnicodeError, configparser.Error, KeyError, ValueError):
        return None


def folder_tags(path):
    marker = path / '.apx-folder-tags'
    try:
        if marker.is_symlink() or marker.stat().st_size > 8192:
            return []
        tags = json.loads(marker.read_text())
        if isinstance(tags, list) and len(tags) <= 20 and all(isinstance(t, str) and 0 < len(t) <= 64 and not any(ord(c) < 32 for c in t) for t in tags):
            return tags
    except (OSError, ValueError):
        pass
    return []


def folder_label(path):
    tags = folder_tags(path)
    return path.name + ('  ·  ' + '  '.join('#' + t for t in tags) if tags else '')


def entries(directory, recursive=False, strict=False):
    """Normal navigation matches a file manager; recursive results are explicit."""
    directory = directory.resolve()
    if not directory.is_relative_to(HOME):
        return
    if directory != HOME:
        yield directory.parent, 'Pasta anterior', 'go-up'
    if not recursive:
        try:
            with os.scandir(directory) as scan:
                contents = sorted(scan, key=lambda item: (not item.is_dir(), item.name.casefold()))
        except OSError:
            if strict:
                raise
            contents = []
        for item in contents:
            if item.name.startswith('.') or (directory == HOME and item.name == 'Applications'):
                continue
            path = Path(item.path)
            app = desktop_entry(path)
            if path.parent == HOME / 'Applications' and path.suffix == '.desktop':
                if app:
                    yield path, app[0], app[1]
                continue
            try:
                if item.is_symlink() and not path.resolve().is_relative_to(HOME):
                    continue
                if item.is_dir():
                    yield path, folder_label(path), 'apx-folder-tagged' if folder_tags(path) else 'folder'
                elif item.is_file():
                    yield path, path.name, 'text-x-generic'
            except OSError:
                continue
        return
    # Legacy explicit recursive requests only; the launcher never takes this path.
    try:
        children = sorted(directory.iterdir(), key=lambda p: p.name.casefold())
    except OSError:
        children = []
    for path in children:
        try:
            if not path.name.startswith('.') and path.is_dir() and path.resolve().is_relative_to(HOME):
                yield path, folder_label(path), 'apx-folder-tagged' if folder_tags(path) else 'folder'
        except OSError:
            continue
    # Keep scandir's cached file types. Resolving every ordinary file repeats
    # a stat for each ancestor, which makes large game/download trees block
    # both Rofi modes during startup. Only links require target resolution.
    pending = [directory]
    while pending:
        root = pending.pop()
        try:
            # Recheck once per directory in case it was replaced while scanning.
            if root.is_symlink() or not root.resolve().is_relative_to(HOME):
                continue
            with os.scandir(root) as scan:
                children = sorted(scan, key=lambda item: item.name.casefold())
        except OSError:
            continue
        dirs, files = [], []
        for item in children:
            if item.name.startswith('.'):
                continue
            try:
                if item.is_dir(follow_symlinks=False):
                    if item.name not in SKIP and Path(item.path) != HOME / 'Applications':
                        dirs.append(item)
                elif item.is_file(follow_symlinks=False):
                    files.append(item)
                elif item.is_symlink():
                    path = Path(item.path)
                    if path.is_file() and path.resolve().is_relative_to(HOME):
                        files.append(item)
            except OSError:
                continue
        dirs.sort(key=lambda item: item.name)
        for item in dirs:
            path = Path(item.path)
            if path.parent != directory and folder_tags(path):
                label = folder_label(path)
                parent = os.path.dirname(relative_name(path, directory))
                if parent:
                    label += f'  ·  {parent}'
                yield path, label, 'apx-folder-tagged'
        for item in files:
            path = Path(item.path)
            parent = os.path.dirname(relative_name(path, directory))
            label = item.name if not parent else f'{item.name}  ·  {parent}'
            yield path, label, 'text-x-generic'
        pending.extend(Path(item.path) for item in reversed(dirs))


def tagged_entries(directory):
    """Search only tagged local directories, never following linked directories."""
    if folder_tags(directory):
        yield directory, folder_label(directory), 'apx-folder-tagged'
    for root, dirs, _ in os.walk(directory, followlinks=False):
        dirs[:] = sorted(d for d in dirs if not d.startswith('.') and d not in SKIP
                         and Path(root, d) != HOME / 'Applications'
                         and not Path(root, d).is_symlink())
        for name in dirs:
            path = Path(root) / name
            if folder_tags(path):
                label = folder_label(path)
                parent = os.path.dirname(relative_name(path, directory))
                if parent:
                    label += f'  ·  {parent}'
                yield path, label, 'apx-folder-tagged'


def spawn(command):
    subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)


def json_directory(value):
    directory = Path(value).resolve()
    if not directory.is_relative_to(HOME) or not directory.is_dir():
        raise ValueError('Pasta fora do diretório pessoal ou indisponível')
    records = []
    for path, label, icon in entries(directory, strict=True):
        if any(c in str(path) for c in ('\n', '\r', '\0', '\x1f')):
            continue
        application = path.parent == HOME / 'Applications' and path.suffix == '.desktop'
        kind = 'application' if application else ('directory' if icon in ('folder', 'apx-folder-tagged', 'go-up') else 'file')
        if kind == 'file':
            suffix = path.suffix.lower()
            if suffix in ('.zip', '.tar', '.gz', '.bz2', '.xz', '.7z', '.rar', '.zst'):
                icon = 'package-x-generic'
            elif suffix in ('.png', '.jpg', '.jpeg', '.gif', '.webp', '.svg'):
                icon = 'image-x-generic'
            elif suffix in ('.mp4', '.mkv', '.webm', '.avi', '.mov'):
                icon = 'video-x-generic'
            elif suffix in ('.mp3', '.wav', '.flac', '.ogg'):
                icon = 'audio-x-generic'
            elif suffix == '.pdf':
                icon = 'application-pdf'
        records.append({'path': str(path), 'label': label, 'icon': icon, 'kind': kind,
                        'search': label + ' ' + relative_name(path, HOME)})
    return {'directory': str(directory), 'entries': records}


def open_entry(value):
    path = Path(value)
    if desktop_entry(path):
        spawn(['gio', 'launch', str(path)])
    elif path.resolve().is_relative_to(HOME):
        if path.is_file():
            spawn(['xdg-open', str(path)])
        elif path.is_dir():
            spawn(['thunar', str(path)])


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--tags-only', action='store_true')
    parser.add_argument('--root', default=str(HOME))
    parser.add_argument('--list-json', metavar='DIRECTORY')
    parser.add_argument('--open-entry', metavar='PATH')
    arguments = sys.argv[1:]
    if os.environ.get('ROFI_RETV') == '1':
        # Rofi appends the selected display label as a positional argument.
        # Only our explicitly configured tags mode has actual option arguments.
        arguments = arguments[:3] if len(arguments) >= 3 and arguments[:2] == ['--tags-only', '--root'] else []
    args = parser.parse_args(arguments)
    if args.list_json is not None:
        print(json.dumps(json_directory(args.list_json), ensure_ascii=False))
        return
    if args.open_entry is not None:
        open_entry(args.open_entry)
        return
    tags_only = args.tags_only
    search_root = Path(args.root).resolve() if args.tags_only else HOME
    if not search_root.is_dir():
        return
    def restore_directory(value):
        if not args.tags_only:
            return current_directory(value)
        try:
            path = Path(value).resolve()
            if path.is_dir() and path.is_relative_to(search_root):
                return path
        except (OSError, ValueError):
            pass
        return search_root
    data = os.environ.get('ROFI_DATA', '')
    try:
        state = json.loads(data)
        tags_only = args.tags_only or bool(state.get('tags_only', False))
        directory = restore_directory(state.get('directory', args.root))
        recursive = bool(state.get('recursive', False))
    except (ValueError, TypeError, AttributeError):
        directory, recursive = restore_directory(data or args.root), tags_only
    selected = os.environ.get('ROFI_INFO', '')
    if os.environ.get('ROFI_RETV') == '1' and selected:
        if selected == 'search-subfolders':
            recursive = True
        elif selected == 'browse-folder':
            recursive, tags_only = False, False
        else:
            path = Path(selected)
            try:
                if desktop_entry(path):
                    spawn(['gio', 'launch', str(path)])
                    return
                if path.resolve().is_relative_to(search_root):
                    if path.is_dir():
                        directory, recursive = path.resolve(), False
                        if tags_only:
                            spawn(['thunar', str(directory)])
                            return
                    elif path.is_file():
                        spawn(['xdg-open', str(path)])
                        return
            except OSError:
                pass
    print('\0prompt\x1f' + ('Etiquetas' if tags_only else 'Ficheiros'))
    print('\0no-custom\x1ftrue')
    print('\0markup-rows\x1ftrue')
    print('\0data\x1f' + json.dumps({'directory': str(directory), 'recursive': recursive, 'tags_only': tags_only}))
    print('\0keep-filter\x1ffalse')
    print('\0new-selection\x1f0')
    rows = tagged_entries(directory) if tags_only else entries(directory)
    for path, label, icon in rows:
        if any(c in str(path) for c in ('\n', '\r', '\0', '\x1f')):
            continue
        safe = label.replace('\n', ' ').replace('\r', ' ')
        print(safe + '\0display\x1f' + html.escape(safe) + '\x1ficon\x1f' + icon
              + '\x1finfo\x1f' + str(path) + '\x1fmeta\x1f' + relative_name(path, search_root) + ' ' + ' '.join(folder_tags(path) if icon in ('folder', 'apx-folder-tagged', 'go-up') else []))


if __name__ == '__main__':
    main()
