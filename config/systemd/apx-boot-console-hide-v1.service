[Unit]
Description=Hide Host console before graphical APX boot
Before=getty@tty1.service getty.target apx-official-hub-autostart-v1.service
ConditionPathExists=/etc/apx-physical-pilot

[Service]
Type=oneshot
ExecStart=/usr/bin/systemctl mask --runtime getty@tty1.service
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
