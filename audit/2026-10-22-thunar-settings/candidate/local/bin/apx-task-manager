#!/usr/bin/env python3
"""A calm application view over this Environment's own process namespace."""
import concurrent.futures
import json
import os
from pathlib import Path
import signal
import subprocess
import time

import gi
gi.require_version('Gtk', '3.0')
from gi.repository import Gtk, GLib, Gio, GObject

HOME = Path.home()
CSS = HOME / '.local/share/apx/graphite-apps.css'
TICKS = os.sysconf('SC_CLK_TCK')
PAGES = os.sysconf('SC_PAGE_SIZE')
ESSENTIAL = {'Hyprland', 'quickshell', 'systemd', 'dbus-broker', 'dbus-daemon',
             'pipewire', 'wireplumber', 'Xwayland', 'apx-task-manager', 'python3'}


def process(pid):
    root = Path('/proc') / str(pid)
    fields = root.joinpath('stat').read_text().rsplit(')', 1)[1].split()
    return {'pid': int(pid), 'parent': int(fields[1]), 'start': int(fields[19]),
            'ticks': int(fields[11]) + int(fields[12]), 'rss': max(0, int(fields[21])) * PAGES,
            'name': root.joinpath('comm').read_text().strip(),
            'uid': root.stat().st_uid}


def gpu_snapshot():
    tool = Path('/usr/bin/nvidia-smi')
    if tool.is_file():
        try:
            result = subprocess.run([str(tool), '--query-gpu=name,utilization.gpu,memory.used,memory.total',
                                     '--format=csv,noheader,nounits'], capture_output=True, text=True, timeout=2)
            if result.returncode == 0:
                name, use, used, total = [part.strip() for part in result.stdout.splitlines()[0].split(',')]
                return {'name': name, 'use': float(use), 'memory': float(used), 'capacity': float(total)}
        except (OSError, ValueError, IndexError, subprocess.TimeoutExpired):
            pass
    for device in sorted(Path('/sys/class/drm').glob('card[0-9]*/device')):
        try:
            use = float((device / 'gpu_busy_percent').read_text())
            return {'name': 'GPU integrada', 'use': use,
                    'memory': int((device / 'mem_info_vram_used').read_text()) / 1024**2,
                    'capacity': int((device / 'mem_info_vram_total').read_text()) / 1024**2}
        except (OSError, ValueError):
            pass
    return None


def snapshot(previous=None):
    now = time.monotonic()
    processes = {}
    for path in Path('/proc').iterdir():
        if path.name.isdigit():
            try:
                item = process(path.name)
                if item['uid'] == os.getuid(): processes[item['pid']] = item
            except (OSError, ValueError, IndexError):
                pass
    result = subprocess.run(['hyprctl', '-j', 'clients'], capture_output=True, text=True, timeout=3)
    if result.returncode: raise RuntimeError('Não foi possível consultar as aplicações abertas.')
    windows = json.loads(result.stdout)
    roots = {}
    for window in windows:
        pid = window.get('pid')
        if pid in processes and window.get('mapped'):
            roots[pid] = {'name': window.get('class') or processes[pid]['name'],
                          'title': window.get('title', '')}
    groups = {}
    old = previous.get('processes', {}) if previous else {}
    elapsed = now - previous['time'] if previous else 0
    for pid, item in processes.items():
        ancestor, seen = pid, set()
        while ancestor not in roots and ancestor in processes and ancestor not in seen:
            seen.add(ancestor)
            ancestor = processes[ancestor]['parent']
        key = ('app', ancestor) if ancestor in roots else ('background', item['name'])
        if key not in groups:
            root = processes.get(ancestor, item) if key[0] == 'app' else item
            names = {'brave-browser': 'Brave', 'apx-settings': 'Definições APX',
                     'xfce4-taskmanager': 'Gestor de Tarefas avançado',
                     'apx-host-console-v1': 'Terminal do Host', 'org.pulseaudio.pavucontrol': 'Controlo de som'}
            name = names.get(roots[ancestor]['name'], roots[ancestor]['name']) if key[0] == 'app' else item['name']
            groups[key] = {'name': name, 'identity': roots[ancestor]['name'] if key[0] == 'app' else '', 'pid': root['pid'], 'start': root['start'],
                           'cpu': 0., 'rss': 0, 'count': 0, 'app': key[0] == 'app',
                           'can_end': key[0] == 'app' and root['pid'] != os.getpid() and
                                      roots[ancestor]['name'] not in {'apx-host-console-v1', 'apx-task-manager'} and
                                      root['name'] not in ESSENTIAL - {'python3'}}
        group = groups[key]
        before = old.get(pid)
        if before and before['start'] == item['start'] and elapsed > 0:
            group['cpu'] += max(0, item['ticks'] - before['ticks']) / TICKS / elapsed * 100
        group['rss'] += item['rss']; group['count'] += 1
    stat = list(map(int, Path('/proc/stat').read_text().splitlines()[0].split()[1:]))
    total, idle = sum(stat[:8]), stat[3] + stat[4]
    cpu = 0.
    if previous and total > previous['total']:
        cpu = 100 * (1 - (idle - previous['idle']) / (total - previous['total']))
    memory = {}
    for line in Path('/proc/meminfo').read_text().splitlines():
        key, value = line.split(':', 1)
        memory[key] = int(value.split()[0]) * 1024
    return {'time': now, 'processes': processes, 'groups': list(groups.values()),
            'total': total, 'idle': idle, 'gpu': gpu_snapshot(), 'cpu': max(0, min(100, cpu)),
            'memory': memory['MemTotal'] - memory['MemAvailable'], 'capacity': memory['MemTotal']}


def terminate(pid, start):
    """Pin identity with a pidfd; a recycled PID must never receive the signal."""
    if pid <= 1 or pid == os.getpid(): raise ValueError('Este processo não pode ser terminado.')
    fd = os.pidfd_open(pid)
    try:
        current = process(pid)
        if current['start'] != start or current['uid'] != os.getuid() or current['name'] in ESSENTIAL - {'python3'}:
            raise ValueError('A aplicação já mudou ou pertence à sessão.')
        signal.pidfd_send_signal(fd, signal.SIGTERM)
    finally:
        os.close(fd)


def text(value, style=None):
    widget = Gtk.Label(label=value, xalign=0)
    if style: widget.get_style_context().add_class(style)
    return widget


class Manager(Gtk.ApplicationWindow):
    __gtype_name__ = 'APXTaskManager'

    def __init__(self, app):
        super().__init__(application=app, title='Gestor de Tarefas')
        self.set_default_size(940, 650)
        self.get_style_context().add_class('apx-graphite-app')
        self.get_style_context().add_class('apx-task-manager-app')
        self.set_size_request(660, 480)
        self.catalogue = {}
        for entry in Gio.AppInfo.get_all():
            if not entry.get_id(): continue
            keys = [entry.get_id().removesuffix('.desktop'), Path(entry.get_executable() or '').name]
            if isinstance(entry, Gio.DesktopAppInfo): keys.append(entry.get_startup_wm_class() or '')
            for key in keys:
                if key: self.catalogue[key.casefold()] = (entry.get_display_name(), entry.get_icon())
        self.service_icon = Gio.ThemedIcon.new('applications-system-symbolic')
        self.previous = None; self.groups = []; self.pending = False; self.closed = False
        self.executor = concurrent.futures.ThreadPoolExecutor(max_workers=1)
        self.connect('destroy', self.on_destroy)
        provider = Gtk.CssProvider(); provider.load_from_path(str(CSS))
        Gtk.StyleContext.add_provider_for_screen(self.get_screen(), provider, Gtk.STYLE_PROVIDER_PRIORITY_USER + 1)
        header = Gtk.HeaderBar(title='Gestor de Tarefas', show_close_button=True)
        header.set_has_subtitle(False)
        self.header = header
        self.set_titlebar(header)
        advanced = Gtk.Button(label='Avançado')
        advanced.set_tooltip_text('Abrir a lista técnica de processos e os controlos avançados')
        advanced.connect('clicked', lambda _: subprocess.Popen(['/usr/bin/env', 'GTK_THEME=APX-Graphite', '/usr/bin/xfce4-taskmanager']))
        header.pack_end(advanced)
        layout = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        layout.set_border_width(22); self.add(layout)
        summaries = Gtk.Box(spacing=12); layout.pack_start(summaries, False, False, 0)
        self.cpu = self.metric(summaries, 'CPU')
        self.memory = self.metric(summaries, 'Memória')
        self.gpu = self.metric(summaries, 'GPU')
        tools = Gtk.Box(spacing=12); layout.pack_start(tools, False, False, 0)
        self.search = Gtk.SearchEntry(placeholder_text='Pesquisar aplicações…')
        self.search.connect('search-changed', lambda _: self.render())
        tools.pack_start(self.search, True, True, 0)
        self.background = Gtk.ToggleButton(label='Incluir serviços')
        self.background.set_tooltip_text('Mostrar também os serviços e processos em segundo plano')
        self.background.connect('toggled', self.toggle_services); tools.pack_end(self.background, False, False, 0)
        # Hidden identity fields are separate from the four human-facing columns.
        self.store = Gtk.ListStore(str, float, str, int, int, GObject.TYPE_UINT64, bool, str, GObject.TYPE_OBJECT)
        self.view = Gtk.TreeView(model=self.store, headers_visible=True, enable_search=False)
        self.view.set_activate_on_single_click(False)
        self.view.set_grid_lines(Gtk.TreeViewGridLines.NONE)
        for title, field in [('Aplicação', 0), ('CPU', 1), ('Memória', 2), ('Processos', 3)]:
            renderer = Gtk.CellRendererText(); renderer.set_property('ypad', 12)
            column = Gtk.TreeViewColumn(title, renderer)
            if field == 1:
                column.set_cell_data_func(renderer, lambda col, cell, model, it, _: cell.set_property('text', f'{model[it][1]:.1f}%'))
            else: column.add_attribute(renderer, 'text', field)
            if field == 0:
                icon = Gtk.CellRendererPixbuf()
                icon.set_property('stock-size', Gtk.IconSize.LARGE_TOOLBAR)
                icon.set_property('xpad', 10)
                column.pack_start(icon, False)
                column.reorder(icon, 0)
                column.add_attribute(icon, 'gicon', 8)
            column.set_expand(field == 0); column.set_sort_column_id(field)
            if field == 2:
                self.store.set_sort_func(2, lambda model, a, b, _: (int(model[a][7]) > int(model[b][7])) - (int(model[a][7]) < int(model[b][7])))
            self.view.append_column(column)
        self.store.set_sort_column_id(0, Gtk.SortType.ASCENDING)
        self.view.get_selection().connect('changed', self.selection_changed)
        scroll = Gtk.ScrolledWindow(); scroll.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        scroll.get_style_context().add_class('card'); scroll.add(self.view)
        layout.pack_start(scroll, True, True, 0)
        footer = Gtk.Box(spacing=12); layout.pack_end(footer, False, False, 0)
        self.status = text('', 'secondary'); self.status.set_line_wrap(True)
        self.status.set_no_show_all(True)
        footer.pack_start(self.status, True, True, 0)
        self.end = Gtk.Button(label='Terminar aplicação'); self.end.set_sensitive(False)
        self.end.connect('clicked', self.end_selected); footer.pack_end(self.end, False, False, 0)
        self.timer = GLib.timeout_add_seconds(2, self.refresh); self.refresh()

    def metric(self, box, title):
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        card.get_style_context().add_class('card'); card.pack_start(text(title, 'secondary'), False, False, 0)
        value = text('—', 'title'); card.pack_start(value, False, False, 0)
        box.pack_start(card, True, True, 0); return value

    def refresh(self):
        if self.closed: return False
        if not self.pending:
            self.pending = True
            future = self.executor.submit(snapshot, self.previous)
            future.add_done_callback(lambda result: GLib.idle_add(self.receive, result))
        return True

    def receive(self, future):
        if self.closed: return False
        self.pending = False
        try:
            data = future.result(); self.previous = data; self.groups = data['groups']
            self.cpu.set_text(f"{data['cpu']:.0f}%")
            self.memory.set_text(f"{data['memory'] / 1024**3:.1f} / {data['capacity'] / 1024**3:.0f} GiB")
            gpu = data['gpu']
            self.gpu.set_text(f"{gpu['use']:.0f}%" if gpu else 'Indisponível')
            self.gpu.set_tooltip_text(f"{gpu['name']} · VRAM: {gpu['memory']:.0f} / {gpu['capacity']:.0f} MiB" if gpu else 'A leitura da GPU não está disponível nesta sessão.')
            self.render()
        except Exception as error:
            self.status.show()
            self.status.set_text('Não foi possível atualizar. Nova tentativa em 2 segundos.')
            self.status.set_tooltip_text(str(error))
        return False

    def render(self):
        selected = self.selected()
        identity = (selected[4], selected[5]) if selected else None
        query = self.search.get_text().strip().casefold()
        self.store.clear()
        for group in self.groups:
            entry = self.catalogue.get(group['identity'].casefold()) if group['app'] else None
            name = entry[0] if entry else group['name']
            icon = (entry[1] if entry and entry[1] else Gio.ThemedIcon.new('application-x-executable-symbolic')) if group['app'] else self.service_icon
            if (group['app'] or self.background.get_active()) and query in name.casefold():
                it = self.store.append([name, group['cpu'], f"{group['rss']/1024**2:.0f} MiB", group['count'], group['pid'], group['start'], group['can_end'], str(group['rss']), icon])
                if (group['pid'], group['start']) == identity: self.view.get_selection().select_iter(it)
        self.selection_changed(self.view.get_selection())
        if not len(self.store):
            self.status.set_text('Sem resultados.' if query else 'Nenhuma aplicação aberta.'); self.status.show()

    def toggle_services(self, widget):
        widget.set_label('Excluir serviços' if widget.get_active() else 'Incluir serviços')
        self.render()

    def selected(self):
        model, it = self.view.get_selection().get_selected()
        return list(model[it]) if it is not None else None

    def selection_changed(self, selection):
        row = self.selected(); self.end.set_sensitive(bool(row and row[6]))
        self.status.hide()

    def end_selected(self, _button):
        row = self.selected()
        if not row or not row[6]: return
        dialog = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
            buttons=Gtk.ButtonsType.NONE, text='Terminar ' + row[0] + '?')
        dialog.format_secondary_text('O trabalho que ainda não foi guardado pode perder-se.')
        dialog.add_button('Cancelar', Gtk.ResponseType.CANCEL); dialog.add_button('Terminar aplicação', Gtk.ResponseType.OK)
        response = dialog.run(); dialog.destroy()
        if response == Gtk.ResponseType.OK:
            try: terminate(row[4], row[5]); self.refresh()
            except (OSError, ValueError) as error:
                self.status.set_text('Não foi possível terminar: ' + str(error)); self.status.show()

    def on_destroy(self, _window):
        self.closed = True; GLib.source_remove(self.timer); self.executor.shutdown(wait=False, cancel_futures=True)


if __name__ == '__main__':
    app = Gtk.Application(application_id='org.apx.TaskManager')
    def activate(application):
        window = application.get_active_window()
        if window is None: window = Manager(application); window.show_all()
        window.present()
    app.connect('activate', activate)
    app.run()
