<actions>
  <action>
    <icon>edit-delete</icon>
    <name>Desinstalar neste Environment</name>
    <submenu />
    <unique-id>1789400000000000-1</unique-id>
    <command>/home/apx/.local/bin/apx-application-remove-v1 %f</command>
    <description>Remove apenas a aplicação selecionada deste Environment</description>
    <range>*.desktop</range>
    <patterns>*.desktop</patterns>
    <startup-notify />
    <directories />
  </action>
  <action>
    <icon>folder</icon>
    <name>Alterar cor da pasta…</name>
    <submenu />
    <unique-id>1791390000000000-1</unique-id>
    <command>/home/apx/.local/bin/apx-folder-color-v1 set %F</command>
    <description>Escolher a cor ou repor a cor predefinida</description>
    <patterns>*</patterns>
    <directories />
  </action>
    <action>
    <icon>document-properties</icon>
    <name>Editar etiquetas…</name>
    <submenu />
    <unique-id>1791390000000000-3</unique-id>
    <command>/home/apx/.local/bin/apx-folder-color-v1 tags %F</command>
    <description>Adicionar ou alterar etiquetas das pastas selecionadas</description>
    <patterns>*</patterns>
    <directories />
  </action>
  <action>
    <icon>edit-copy</icon>
    <name>Enviar cópia para Partilha Environments</name>
    <unique-id>1794500000000000-1</unique-id>
    <command>/home/apx/.local/bin/apx-share-copy-v1 copy %F</command>
    <description>Cria cópias independentes na pasta partilhada</description>
    <patterns>*</patterns>
    <directories />
  </action>
  <action>
    <icon>folder-new</icon>
    <name>Criar subpasta na Partilha</name>
    <unique-id>1794500000000000-2</unique-id>
    <command>/home/apx/.local/bin/apx-share-copy-v1 mkdir %f</command>
    <description>Cria uma subpasta dentro de Partilha Environments</description>
    <patterns>*</patterns>
    <directories />
  </action>
    <action>
    <icon>package-x-generic</icon>
    <name>Comprimir</name>
    <submenu />
    <unique-id>1794864000000000-1</unique-id>
    <command>/home/apx/.local/bin/apx-compress-v1 %F</command>
    <description>Criar um arquivo ou pacote Minecraft</description>
    <patterns>*</patterns>
    <directories /><audio-files /><image-files /><other-files /><text-files /><video-files />
  </action>
</actions>
