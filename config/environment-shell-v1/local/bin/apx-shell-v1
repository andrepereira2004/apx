#!/usr/bin/bash
set -u

handoff_proof=/run/apx/authenticated-handoff-v1
if [[ ${1:-} == --reveal-handoff-cursor || ${1:-} == --handoff-cursor-fallback ]]; then
    [[ -r $handoff_proof ]] || exit 0
    cursor_ready=${XDG_RUNTIME_DIR:-/run/user/1000}/apx-handoff-cursor-ready-v1
    [[ ! -e $cursor_ready ]] || exit 0
    if [[ $1 == --handoff-cursor-fallback ]]; then
        /usr/bin/sleep 20
        [[ ! -e $cursor_ready ]] || exit 0
    fi
    cursor_ctl() {
        local reply
        reply=$(/usr/bin/timeout 2 /usr/bin/hyprctl "$@") && [[ $reply == ok ]]
    }

    # Keep the compositor's real pointer position and hotspot throughout.
    # The fallback restores immediately if the animation cannot be prepared.
    if [[ $1 == --reveal-handoff-cursor ]] \
        && /usr/bin/timeout 1 /home/apx/.local/bin/apx-cursor-fade-v1 \
        && cursor_ctl eval 'hl.config({cursor={enable_hyprcursor=true,sync_gsettings_theme=false}})' \
        && cursor_ctl setcursor APX-Handoff-Fade 24 \
        && cursor_ctl eval 'hl.config({cursor={invisible=false}})'; then
        # Allow Hyprland's 500 ms visibility tick and the 150 ms animation.
        /usr/bin/sleep 0.70
    fi
    restore_cursor='hl.env("XCURSOR_THEME","default"); hl.config({cursor={invisible=false,enable_hyprcursor=true,sync_gsettings_theme=true}})'
    cursor_ctl setcursor default 24 || cursor_error=1
    cursor_ctl eval "$restore_cursor" || exit 1
    [[ ${cursor_error:-0} == 0 ]] || exit 1
    /usr/bin/install -m 0600 /dev/null "$cursor_ready" || exit 1
    printf 'APX: cursor restored (%s) %(%Y-%m-%dT%H:%M:%S%z)T\n' "$1" -1 \
        >>/home/apx/.local/state/apx-shell-v1/quickshell.log
    exit 0
fi

# The supervised fallback may launch this before hyprland.start runs.
if [[ ${XCURSOR_THEME:-} == APX-Handoff-Transparent ]]; then
    export XCURSOR_THEME=default
fi

# Authentication and child applications must retain the real account name.
# Human-facing labels belong in the UI, never in the login identity.
export USER=apx
export LOGNAME=apx
export QT_QPA_PLATFORMTHEME=xdgdesktopportal
export GTK_USE_PORTAL=1

# Locale choices apply only to this Environment and its session children.
if [[ -r /home/apx/.config/apx/locale.env ]]; then
    set -a
    . /home/apx/.config/apx/locale.env
    set +a
fi

config=/home/apx/.config/quickshell/apx/shell.qml
lock_config=/home/apx/.config/hypr/hyprlock.conf
idle_config=/home/apx/.config/hypr/hypridle.conf
state_dir=/home/apx/.local/state/apx-shell-v1
log=$state_dir/quickshell.log
login_marker=${XDG_RUNTIME_DIR:-/run/user/1000}/apx-initial-login-v1
launcher_lock=${XDG_RUNTIME_DIR:-/run/user/1000}/apx-shell-launcher-v2.lock

# The Lua autostart and the supervised IPC fallback may race on a physical
# launch. Only one owner shell may run the login flow and the QuickShell retry
# loop; a losing launcher exits successfully without touching the compositor.
exec 9>"$launcher_lock"
if ! /usr/bin/flock -n 9; then
    exit 0
fi

install -d -m 0700 "$state_dir"
# Establish the default vault before any desktop service/application asks for it.
/usr/bin/python3 /home/apx/.local/bin/apx-keyring-prepare-v1 >>"$log" 2>&1 || \
    printf 'APX: não foi possível preparar o cofre local.\n' >>"$log"
/home/apx/.local/bin/apx-application-catalog-v1 >/dev/null 2>&1 || true
if [[ -f $log ]] && (( $(stat -c %s "$log") > 1048576 )); then
    mv -f -- "$log" "$log.previous"
fi

if ! command -v quickshell >/dev/null 2>&1; then
    printf 'APX: Quickshell não está instalada; nenhuma shell será iniciada.\n' >>"$log"
    exit 127
fi

if [[ ! -r $config ]]; then
    printf 'APX: configuração Quickshell indisponível: %s\n' "$config" >>"$log"
    exit 1
fi

if [[ ! -e $login_marker ]]; then
    if [[ -r $handoff_proof ]]; then
        printf '\n=== APX authenticated handoff %(%Y-%m-%dT%H:%M:%S%z)T ===\n' -1 >>"$log"
        /usr/bin/install -m 0600 /dev/null "$login_marker"
    elif [[ ! -x /usr/bin/hyprlock || ! -r $lock_config ]]; then
        printf 'APX: login inicial indisponível; a sessão gráfica será encerrada.\n' >>"$log"
        /usr/bin/hyprctl dispatch 'hl.dsp.exit()' >/dev/null 2>&1 || true
        exit 1
    else
        printf '\n=== APX initial login %(%Y-%m-%dT%H:%M:%S%z)T ===\n' -1 >>"$log"
        if ! /usr/bin/hyprlock --immediate-render --no-fade-in --config "$lock_config" >>"$log" 2>&1; then
            printf 'APX: hyprlock terminou sem autenticação; a sessão gráfica será encerrada.\n' >>"$log"
            /usr/bin/hyprctl dispatch 'hl.dsp.exit()' >/dev/null 2>&1 || true
            exit 1
        fi
        /usr/bin/install -m 0600 /dev/null "$login_marker"
    fi
fi

# Do not impose a fixed four-second delay.  Start as soon as Hyprland IPC has
# reported a real enabled monitor twice in succession; the second observation
# preserves the settling protection needed by portal and layer-shell clients.
ready_observations=0
for _ in {1..40}; do
    if /usr/bin/hyprctl -j monitors 2>/dev/null | /usr/bin/grep -Fq '"disabled": false'; then
        ((ready_observations += 1))
        ((ready_observations >= 2)) && break
    else
        ready_observations=0
    fi
    /usr/bin/sleep 0.05
done

if [[ -x /usr/bin/hypridle && -r $idle_config ]] && ! /usr/bin/pidof hypridle >/dev/null 2>&1; then
    /usr/bin/hypridle --quiet --config "$idle_config" >>"$log" 2>&1 9>&- &
fi

start_desktop_service() {
    local pattern=$1
    shift
    if [[ -x $1 ]] && ! /usr/bin/pgrep -u "$(id -u)" -f "$pattern" >/dev/null 2>&1; then
        "$@" >>"$log" 2>&1 9>&- &
    fi
}

# Publish Wayland/X11 and application paths before any portal is activated.
/home/apx/.local/bin/apx-desktop-activation-v1 >>"$log" 2>&1 || \
    printf 'APX: não foi possível preparar a abertura de aplicações por D-Bus.\n' >>"$log"

# These are ordinary desktop facilities, not APX privileges. Keeping them in
# the Environment makes notifications, password storage, file pickers and
# removable-media prompts behave like a normal Linux desktop.
start_desktop_service '^/usr/bin/gnome-keyring-daemon' \
    /usr/bin/gnome-keyring-daemon --start --components=secrets
start_desktop_service '^/home/apx/.local/libexec/apx-xdph-v1' \
    /home/apx/.local/libexec/apx-xdph-v1
start_desktop_service '^/usr/lib/xdg-desktop-portal-gtk' \
    /usr/bin/env GTK_MODULES=/home/apx/.local/lib/apx/libchooser-places.so /usr/lib/xdg-desktop-portal-gtk
start_desktop_service '^/usr/bin/mako([[:space:]]|$)' /usr/bin/mako
start_desktop_service '[/]apx-notification-focus-v1([[:space:]]|$)' \
    /home/apx/.local/bin/apx-notification-focus-v1
start_desktop_service '^/usr/lib/hyprpolkitagent/hyprpolkitagent' \
    /usr/lib/hyprpolkitagent/hyprpolkitagent
start_desktop_service '^/usr/bin/udiskie([[:space:]]|$)' /usr/bin/udiskie --automount --no-tray --no-notify
start_desktop_service '[/]apx-removable-bookmark-v1([[:space:]]|$)' \
    /home/apx/.local/bin/apx-removable-bookmark-v1 --watch
start_desktop_service '[/]apx-removable-notifications-v1([[:space:]]|$)' \
    /home/apx/.local/bin/apx-removable-notifications-v1

# Keep the Environment-local file manager ready without blocking shell startup.
# The existing Thunar daemon exits with this Environment session.
if [[ -x /usr/bin/thunar ]]; then
    start_desktop_service '^/usr/bin/[Tt]hunar([[:space:]]|$)' \
        /home/apx/.local/bin/thunar --daemon
fi

# User-selected startup applications and optional clipboard history.
if [[ -x /home/apx/.local/bin/apx-desktop-preferences-v1 ]]; then
    /home/apx/.local/bin/apx-desktop-preferences-v1 session >>"$log" 2>&1 || true
fi

while true; do
    printf '\n=== APX shell start %(%Y-%m-%dT%H:%M:%S%z)T ===\n' -1 >>"$log"
    animate_handoff=0
    if [[ -r $handoff_proof && ! -e ${XDG_RUNTIME_DIR:-/run/user/1000}/apx-handoff-cursor-ready-v1 ]]; then
        animate_handoff=1
    fi
    APX_ANIMATE_HANDOFF=$animate_handoff QT_SCALE_FACTOR=1.1 \
        quickshell --no-duplicate --path "$config" --no-color --log-times -v >>"$log" 2>&1 9>&-
    status=$?
    printf 'APX: Quickshell terminou com estado %s; nova tentativa dentro de 2 segundos.\n' "$status" >>"$log"
    /usr/bin/sleep 2
done
